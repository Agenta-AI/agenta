            {
              "kind": "gateway",
              "provider": "composio",
              "integration": "slack"
            },
            {
              "kind": "gateway",
              "provider": "composio",
              "integration": "discord"
            },
            {
              "kind": "gateway",
              "provider": "composio",
              "integration": "telegram"
            }
          ],
          "setup_notes": "Reply to customer questions"
