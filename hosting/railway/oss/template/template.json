    "AGENTA_AUTH_KEY": {
      "from_env": "AGENTA_AUTH_KEY",
      "generate": "openssl-rand-hex-32"
    },
    "AGENTA_CRYPT_KEY": {
      "from_env": "AGENTA_CRYPT_KEY",
      "generate": "openssl-rand-hex-32"
    },
    "AGENTA_SERVICES_INTERNAL_KEY": {
