{
    "name": "@agenta/storybook",
    "private": true,
    "version": "0.0.0",
    "description": "Storybook workbench for the antd → @agenta/ui migration. Renders real @agenta/* components behind the real app providers so antd and @agenta/ui versions can be compared side by side.",
    "scripts": {
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build -o storybook-static",
        "lint": "eslint --config ../eslint.config.mjs stories/ .storybook/ parity/ --max-warnings 0",
        "vrt": "node parity/vrt.mjs",
        "a11y": "node parity/a11y.mjs"
    },
    "dependencies": {
        "@agenta/chat": "workspace:*",
        "@agenta/entities": "workspace:*",
        "@agenta/entity-ui": "workspace:*",
        "@agenta/oss": "workspace:*",
        "@agenta/playground": "workspace:*",
        "@agenta/playground-ui": "workspace:*",
        "@agenta/shared": "workspace:*",
        "@agenta/ui": "workspace:*",
        "@phosphor-icons/react": "^2.1.10",
        "lucide-react": "^0.479.0",
        "next": "15.5.18"
    },
    "devDependencies": {
        "@ant-design/icons": "^6.1.0",
        "@storybook/addon-docs": "9.1.20",
        "@storybook/nextjs": "^9.1.0",
        "@tanstack/react-query": "^5.90.21",
        "@types/node": "^20.19.20",
        "@types/react": "^19.0.10",
        "@types/react-dom": "^19.0.4",
        "antd": "^6.1.3",
        "autoprefixer": "10.4.20",
        "axe-core": "^4.12.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "jotai": "^2.16.1",
        "jotai-tanstack-query": "^0.11.0",
        "next": "15.5.18",
        "pixelmatch": "5.3.0",
        "playwright": "1.60.0",
        "pngjs": "7.0.0",
        "postcss": "^8.5.23",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "remark-gfm": "^4.0.1",
        "storybook": "^9.1.0",
        "storybook-addon-pseudo-states": "^9.1.20",
        "tailwind-merge": "^2.6.0",
        "tailwindcss": "^3.4.4",
        "typescript": "^5.9.3"
    }
}
