{
    "name": "@agenta/storybook",
    "private": true,
    "version": "0.0.0",
    "description": "Storybook for the @agenta/* packages and /m screens. Renders real components behind the /m app's providers and stylesheet.",
    "scripts": {
        "storybook": "storybook dev -p 6006",
        "build-storybook": "NODE_OPTIONS=--max-old-space-size=8192 storybook build -o storybook-static",
        "lint": "eslint --config ../eslint.config.mjs stories/ .storybook/ --max-warnings 0"
    },
    "dependencies": {
        "@agenta/chat": "workspace:*",
        "@agenta/entities": "workspace:*",
        "@agenta/entity-ui": "workspace:*",
        "@agenta/playground": "workspace:*",
        "@agenta/playground-ui": "workspace:*",
        "@agenta/sessions-ui": "workspace:*",
        "@agenta/settings-ui": "workspace:*",
        "@agenta/shared": "workspace:*",
        "@agenta/skills": "workspace:*",
        "@agenta/skills-ui": "workspace:*",
        "@agenta/ui": "workspace:*",
        "@phosphor-icons/react": "^2.1.10",
        "lucide-react": "^0.479.0",
        "next": "15.5.28"
    },
    "devDependencies": {
        "@storybook/addon-docs": "9.1.20",
        "@storybook/nextjs": "^9.1.0",
        "@tailwindcss/postcss": "^4.1.0",
        "@tanstack/react-query": "^5.90.21",
        "@types/node": "^20.19.20",
        "@types/react": "^19.0.10",
        "@types/react-dom": "^19.0.4",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "jotai": "^2.16.1",
        "jotai-tanstack-query": "^0.11.0",
        "next": "15.5.28",
        "postcss": "^8.5.23",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "remark-gfm": "^4.0.1",
        "storybook": "^9.1.21",
        "storybook-addon-pseudo-states": "^9.1.20",
        "tailwind-merge": "^2.6.0",
        "tailwindcss": "^4.1.0",
        "typescript": "^5.9.3"
    }
}
