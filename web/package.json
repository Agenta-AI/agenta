{
    "name": "agenta-web",
    "version": "0.128.14",
    "workspaces": [
        "mobile",
        "tests",
        "packages/*",
        "website"
    ],
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.5",
        "@eslint/js": "^9.39.4",
        "@lexical/eslint-plugin": "^0.46.0",
        "@next/eslint-plugin-next": "15.5.18",
        "@typescript-eslint/eslint-plugin": "^8.61.0",
        "@typescript-eslint/parser": "^8.61.0",
        "@typescript/native-preview": "7.0.0-dev.20260707.2",
        "eslint": "^9.39.4",
        "eslint-config-next": "15.5.18",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "husky": "^9.1.7",
        "node-fetch": "^3.3.2",
        "prettier": "^3.7.4",
        "prettier-eslint": "^16.4.2",
        "prettier-plugin-tailwindcss": "^0.1.13",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "tsx": "^4.22.4",
        "turbo": "2.10.5",
        "typescript-eslint": "^8.61.0"
    },
    "packageManager": "pnpm@11.1.2+sha512.415a1cc25974731e75455c1468371be74c5aa5fb7621b50d4056d222451609f11412f23fd602e6169f1e060466641f798597e1be961a10688836a67b16569499",
    "scripts": {
        "build-mobile": "turbo run build --filter=@agenta/mobile",
        "dev-mobile": "turbo run dev --filter=@agenta/mobile",
        "lint": "turbo run lint",
        "lint-fix": "turbo run lint -- --fix",
        "format": "prettier --check \"**/*.{js,jsx,cjs,mjs,ts,tsx,cts,mts,mdx}\" --ignore-path ./.prettierignore --ignore-path ../.gitignore",
        "format-fix": "prettier --write \"**/*.{js,jsx,cjs,mjs,ts,tsx,cts,mts,mdx}\" --ignore-path ./.prettierignore --ignore-path ../.gitignore",
        "generate:tailwind-tokens": "GEN_WRITE=1 tsx scripts/generate-tailwind-tokens.ts && pnpm --filter @agenta/mobile generate:tokens",
        "generate:phosphor-catalog": "pnpm --filter @agenta/ui generate:icons"
    }
}
