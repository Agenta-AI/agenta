---
import Section from "./Section.astro";
import Badge from "./Badge.astro";
import "../styles/restored-sections.css";
import "../styles/review-approved.css";
---
<Section class="" data-screen-label="Open source" id="section-29" style="background: var(--th-darksec-oss);" tone="dark"><div class="ag-secpad" style="padding: var(--section-pad-y) 0; display: flex; justify-content: center;"><div class="ag-oss" style="width: min(1120px, 100%); display: grid; grid-template-columns: 420px 1fr; gap: 72px; padding: 0px 28px; box-sizing: border-box; align-items: center; text-align: left;"><div style="display: flex; flex-direction: column; gap: 24px;"><Badge style="align-self: flex-start;" variant="dark">Open source</Badge><h2 class="ag-bighead" style='margin: 0px; font: 300 44px / 1.1 "GT Alpina", serif; color: rgb(247, 246, 244); text-wrap: pretty;'>Self-host Agenta on your infrastructure</h2><span style="font: var(--text-body-md); color: rgba(255, 255, 255, 0.55); text-wrap: pretty;">MIT-licensed. Keep your agents and data on your own premises. No lock-in.</span><div style="display: flex; gap: 10px; flex-wrap: wrap;"><span style="display: inline-flex; align-items: center; height: 30px; padding: 0px 12px; border-radius: 999px; background: rgba(255, 255, 255, 0.05); box-shadow: rgba(255, 255, 255, 0.12) 0px 0px 0px 1px inset; font: 500 12.5px/1 var(--font-sans); color: rgba(255, 255, 255, 0.75);">MIT license</span><a class="ag-oss-chip" href="https://docs.agenta.ai/self-host/quick-start" rel="noopener" style="display: inline-flex; align-items: center; height: 30px; padding: 0px 12px; border-radius: 999px; background: rgba(255, 255, 255, 0.05); box-shadow: rgba(255, 255, 255, 0.12) 0px 0px 0px 1px inset; font: 500 12.5px/1 var(--font-sans); color: rgba(255, 255, 255, 0.75); text-decoration: none;" target="_blank">Docker Compose</a><a class="ag-oss-chip" href="https://docs.agenta.ai/self-host/guides/deploy-to-kubernetes" rel="noopener" style="display: inline-flex; align-items: center; height: 30px; padding: 0px 12px; border-radius: 999px; background: rgba(255, 255, 255, 0.05); box-shadow: rgba(255, 255, 255, 0.12) 0px 0px 0px 1px inset; font: 500 12.5px/1 var(--font-sans); color: rgba(255, 255, 255, 0.75); text-decoration: none;" target="_blank">Helm charts</a>
</div><div class="ag-oss-btns" style="display: flex; gap: 12px; margin-top: 6px;"><a class="ag-btn ag-btn--primary" href="https://github.com/Agenta-AI/agenta" rel="noopener" target="_blank">Explore on GitHub</a><a class="ag-ghost" href="https://docs.agenta.ai/self-host/quick-start" rel="noopener" style="display: inline-flex; align-items: center; white-space: nowrap; height: 40px; padding: 0px 18px; border-radius: 8px; background: rgba(255, 255, 255, 0.05); box-shadow: rgba(255, 255, 255, 0.14) 0px 0px 0px 1px inset; font: 500 14px/1 var(--font-sans); color: rgb(247, 246, 244); text-decoration: none;" target="_blank">Self-hosting docs</a>
</div>
</div><div style="border-radius: 12px; background: rgb(11, 10, 12); box-shadow: rgba(255, 255, 255, 0.1) 0px 0px 0px 1px, rgba(0, 0, 0, 0.5) 0px 24px 64px; overflow: hidden;"><div style="display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; border-bottom: 1px solid rgba(255, 255, 255, 0.08);"><h3 style='margin: 0px; font: 400 12px / 1 "Geist Mono", monospace; color: rgba(255, 255, 255, 0.4);'>self-host — with your coding agent</h3><div style="display: contents;"><button style="display: inline-flex; align-items: center; gap: 6px; flex-shrink: 0; white-space: nowrap; height: 26px; padding: 0px 10px; border-radius: 7px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; background: rgba(255, 255, 255, 0.05); box-shadow: rgba(255, 255, 255, 0.12) 0px 0px 0px 1px inset; font: 500 11.5px/1 var(--font-sans); color: rgba(255, 255, 255, 0.7); cursor: pointer;" type="button"><svg fill="none" height="12" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="12"><rect height="14" rx="2" width="14" x="8" y="8">
</rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2">
</path>
</svg>Copy prompt</button>
</div>
</div><div style='padding: 24px 22px 28px; display: flex; flex-direction: column; gap: 12px; font: 400 14px / 1.6 "Geist Mono", monospace;'><span style="color: rgba(255, 255, 255, 0.35);"># paste into Claude Code — it walks you through setup and testing</span><span style="color: rgb(247, 246, 244);"><span style="color: rgba(255, 255, 255, 0.35);">$ </span>npx skills add Agenta-AI/agenta-skills</span><span style="color: rgb(247, 246, 244);"><span style="color: rgba(255, 255, 255, 0.35);">&gt; </span>Help me self-host Agenta with its repository.</span><span style="color: rgba(242, 242, 92, 0.9);">→ Agenta running at agenta.acme.com</span>
</div>
</div>
</div>
</div>
</Section>
