---
import {GitHubMark} from "@agenta/ui/github-mark";
import Badge from "./Badge.astro";
import Section from "./Section.astro";
// Homepage hero copy from the coworkers landing design.
import WorkspaceDemo from "./WorkspaceDemo.jsx";
import {demoTheme} from "./workspace-demo/theme.js";
import "../styles/workspace-demo.css";

const GET_STARTED = "https://cloud.agenta.ai/";
const BOOK_DEMO = "https://cal.com/mahmoud-mabrouk-ogzgey/demo?duration=30";

// heroPre + [chip] + heroPost form the headline. The chip is the single
// PP Mondwest highlighted word (yellow), per the type-role rules.
const heroPre = "AI ";
const heroChip = "coworkers";
const heroPost = " that learn how you work.";
const heroSub =
  "Get more work done with AI coworkers for every team. Work alongside them in Slack or Telegram to run and automate tasks.";

---

<Section
  data-screen-label="Hero"
  class="ag-hero"
  style="background:var(--th-bg-1);padding:128px 0 136px;text-align:center;"
>
  <div style="display:flex;flex-direction:column;align-items:center;gap:32px;">
    <div style="display:flex;flex-direction:column;align-items:center;gap:28px;">
      <Badge href="https://github.com/Agenta-AI/agenta" target="_blank" rel="noopener">
        <GitHubMark />Open-source
      </Badge>
      <h1
        class="ag-h1"
        style="margin:0;font:var(--text-display-xl);color:var(--th-text-hi);max-width:900px;text-wrap:pretty;"
      >
        {heroPre}<span
          class="ag-hero-chip"
          style="display:inline-block;padding:0.02em 0.1em 0.08em;border-radius:10px;background:var(--hchip-bg);box-shadow:var(--hchip-shadow);font-family:var(--font-bitmap,'PP Mondwest',monospace);font-weight:400;line-height:1.06;color:var(--hchip-text);vertical-align:baseline;"
          >{heroChip}</span
        ><span>{heroPost}</span>
      </h1>
      <p
        style="margin:0;font:var(--text-body-md);color:var(--th-text-body);max-width:620px;text-wrap:pretty;"
      >
        {heroSub}
      </p>
    </div>

    <div style="display:flex;gap:12px;">
      <a
        class="ag-btn ag-btn--primary"
        href={GET_STARTED}
        target="_blank"
        rel="noopener"
        >Try for free</a
      >
      <a
        class="ag-btn ag-btn--outline"
        href={BOOK_DEMO}
        target="_blank"
        rel="noopener"
        >Book a demo</a
      >
    </div>

    <WorkspaceDemo client:visible />
  </div>
</Section>
<style is:global set:html={demoTheme} />

<style is:global>
  /* Highlighted-word chip: light = grey keycap chip with ink text (mockup);
     dark = the current translucent chip with the yellow bitmap word. */
  .ag-hero-chip {
    --hchip-bg: var(--grad-chip);
    --hchip-shadow: inset 0 2px 0.4px #ffffff;
    --hchip-text: var(--ink-900);
  }
  [data-theme="dark"] .ag-hero-chip {
    --hchip-bg: rgba(255, 255, 255, 0.07);
    --hchip-shadow:
      inset 0 1px 0.4px rgba(255, 255, 255, 0.25),
      0 0 0 1px rgba(255, 255, 255, 0.06);
    --hchip-text: var(--yellow-400);
  }
</style>
