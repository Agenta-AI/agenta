---
import "../../styles/landing/templates.css";
import { templates } from "../../lib/templates";
---

<div class="sx-site"><section class="ag-section ag-secpad lp-tpl tplx" data-screen-label="Templates" style="background:var(--th-bg-1);padding:var(--section-pad-y) 24px;">
  <div class="lp-tplin"><header class="ag-sechead" style="display:flex;flex-direction:column;gap:16px;align-items:center;text-align:center;max-width:677px;"><h2 class="ag-sectitle" style="margin:0;font:var(--text-display-lg);color:var(--st-title);text-wrap:pretty;">Start from an agent that already works</h2><p style="margin:0;font:var(--text-body-md);color:var(--st-sub);text-wrap:pretty;">Pick a template, connect your apps, and change it for your team or your client.</p></header>
    <div class="tsp"></div>
    <div class="grid lp-grid"><a href="/marketplace/meeting-followup" class="c">
        <div class="bn"><div class="art"><div class="chat"><span class="p white">Follow up with Acme?</span><span class="p dark ans">Drafted a recap, the pricing link and next steps.</span><span class="p y"><span class="gl"><svg width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 6.2l2.3 2.3 4.7-5"></path></svg></span>Approve and send</span></div></div></div>
        <div class="tx"><h3>Meeting Follow-up</h3><p class="d">Drafts the follow-up email and logs notes to the CRM.</p><span class="go">View template<svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"></path></svg></span></div>
      </a><a href="/marketplace/lead-qualifier" class="c">
        <div class="bn"><div class="art"><div class="col"><p class="cap">New leads</p><span class="p white"><span class="gl"><i class="d"></i></span>Northwind · 320 seats<em>call</em></span><span class="p white"><span class="gl"><i class="d"></i></span>Acme Retail<em>warm</em></span><span class="p ghost"><span class="gl"><i class="r"></i></span>Bloom Studio<em>later</em></span></div></div></div>
        <div class="tx"><h3>Lead Qualifier</h3><p class="d">Enriches and qualifies new inbound leads.</p><span class="go">View template<svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"></path></svg></span></div>
      </a><a href="/marketplace/support-reply-drafter" class="c">
        <div class="bn"><div class="art"><div class="chat"><span class="p white">Can I change my plan?</span><span class="p dark ans">Yes. Here is how, step by step.</span><span class="p y"><span class="gl"><svg width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 6.2l2.3 2.3 4.7-5"></path></svg></span>Draft ready · 2m</span></div></div></div>
        <div class="tx"><h3>Support Reply Drafter</h3><p class="d">Drafts replies to new tickets from your docs and leaves them for review.</p><span class="go">View template<svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"></path></svg></span></div>
      </a><a href="/marketplace/seo-content-agent" class="c">
        <div class="bn"><div class="art"><div class="steps"><p class="cap">Weekly plan · Mon</p><div class="srow"><span class="gl"><svg width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 6.2l2.3 2.3 4.7-5"></path></svg></span><span>Read 48 pages</span></div><div class="srow"><span class="gl"><svg width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 6.2l2.3 2.3 4.7-5"></path></svg></span><span>Found 7 content gaps</span></div><div class="srow last"><span class="p y"><span class="gl"><i class="d"></i></span>3 briefs ready</span></div></div></div></div>
        <div class="tx"><h3>SEO Content Agent</h3><p class="d">Researches search opportunities and turns approved briefs into content.</p><span class="go">View template<svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"></path></svg></span></div>
      </a></div>
    <div style="display:flex;justify-content:center;margin-top:40px"><a class="ag-btn ag-btn--outline" href="/marketplace">See all {templates.length} templates</a></div>
  </div>
</section></div>
