th d="M12 19V5M5 12l7-7 7 7"></path></svg></span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"></path></svg></span></div></div></div></div></div></div></div><div class="lp-demo-live" hidden><WorkspaceDemo client:idle /></div></div></Section></div></div>

<style is:global set:html={demoTheme} />

<script is:inline>
  // The static sidebar (DemoSidebar, rendered without JS) opens the interactive demo.
  (() => {
    const frame = document.querySelector(".r3-ag-app-frame");
    const live = document.querySelector(".lp-demo-live");
    const side = frame && frame.querySelector(".dsb");
    if (!frame || !live || !side) return;
    live.tabIndex = -1;
    const show = (on) => {
      frame.hidden = on;
      live.hidden = !on;
    };
    const go = (detail) => {
      window.__agDemoGo = detail;
      window.dispatchEvent(new CustomEvent("ag-demo-go", { detail }));
      show(true);
      live.focus();
    };
    for (const row of side.querySelectorAll("[data-go]")) {
      const detail = JSON.parse(row.dataset.go);
      // The live row is the run already on screen.
      if (detail.live) continue;
      row.addEventListener("click", () =>
        go({
          ...detail,
          // The live demo keeps the hero pane's open or hidden state.
          configOpen: frame.querySelector(".ws-split")?.dataset.config !== "false",
        }),
      );
    }
    for (const toggle of side.querySelectorAll(".dsb-group-toggle")) {
      toggle.addEventListener("click", () => {
        const open = toggle.getAttribute("aria-expanded") !== "false";
        toggle.setAttribute("aria-expanded", String(!open));
        toggle.closest(".dsb-group")?.toggleAttribute("data-closed", open);
      });
    }
    side.querySelector("[data-dsb-toggle]")?.addEventListener("click", (e) => {
      const collapsed = !side.hasAttribute("data-collapsed");
      side.toggleAttribute("data-collapsed", collapsed);
      frame.querySelector(".r3-aw")?.toggleAttribute("data-collapsed", collapsed);
      e.currentTarget.setAttribute("aria-label", collapsed ? "Expand sidebar" : "Collapse sidebar");
      e.currentTarget.setAttribute("aria-expanded", String(!collapsed));
    });
    window.addEventListener("ag-demo-live", () => show(false));
  })();
</script>
