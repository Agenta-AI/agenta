---
import "../../styles/landing/hero.css";
import Badge from "../Badge.astro";
import Button from "../Button.astro";
import Section from "../Section.astro";
import { formatStars, githubStars } from "../../lib/githubStars";
// Clickable workspace demo; a hero sidebar click swaps it in (script below).
import WorkspaceDemo from "../WorkspaceDemo.jsx";
import HeroConfig from "../workspace-demo/HeroConfig.jsx";
import { deriveWorkspace } from "../workspace-demo/model.js";
import { demoTheme } from "../workspace-demo/theme.js";
import "../../styles/workspace-demo.css";
import "../../styles/demo-primitives.css";
import "../../styles/playground-settings.css";

const stars = formatStars(await githubStars());

// Plain data for the hero's configuration pane (the Lead Qualifier agent).
const lq = deriveWorkspace({ view: "playground", session: 7 }, () => {}, () => {}).ss;
const heroAgent = {
  title: lq.title,
  desc: lq.desc,
  model: lq.model,
  configIntegrations: lq.configIntegrations,
  configSkills: lq.configSkills.map(({ slug, desc }) => ({ slug, desc })),
  subagents: lq.subagents.map(({ title, desc }) => ({ title, desc })),
  autos: lq.autos.map(({ name, runsWhen }) => ({ name, runsWhen })),
  files: lq.files,
};
---

<div class="r3"><div><Section class="r3-ag-hero" data-screen-label="Hero" style="background:var(--lp-surface);padding:128px 0 136px;text-align:center;"><div style="display:flex;flex-direction:column;align-items:center;gap:32px;"><div style="display:flex;flex-direction:column;align-items:center;gap:28px;"><Badge href="https://github.com/Agenta-AI/agenta" rel="noopener" target="_blank"><svg aria-hidden="true" fill="currentColor" height="13" viewBox="0 0 24 24" width="13"><path d="M12 1.5c-5.8 0-10.5 4.7-10.5 10.5 0 4.64 3 8.58 7.18 9.97.53.1.72-.23.72-.5 0-.25-.01-1.08-.01-1.96-2.64.49-3.32-.64-3.53-1.23-.12-.3-.63-1.23-1.08-1.48-.37-.2-.89-.68-.01-.7.83-.01 1.42.76 1.61 1.08.94 1.59 2.45 1.14 3.06.87.09-.68.37-1.14.67-1.4-2.34-.26-4.78-1.17-4.78-5.19 0-1.14.41-2.08 1.08-2.82-.11-.26-.47-1.34.1-2.78 0 0 .88-.28 2.89 1.08a9.77 9.77 0 0 1 5.25 0c2.01-1.37 2.89-1.08 2.89-1.08.58 1.44.21 2.52.1 2.78.67.73 1.08 1.67 1.08 2.82 0 4.03-2.45 4.92-4.79 5.18.38.33.71.96.71 1.94 0 1.4-.01 2.54-.01 2.89 0 .28.19.61.72.5A10.52 10.52 0 0 0 22.5 12c0-5.8-4.7-10.5-10.5-10.5Z"></path></svg>Star us on GitHub · {stars}</Badge><h1 class="r3-ag-h1" style="margin:0;font:300 68px/72px 'GT Alpina', Georgia, 'Times New Roman', serif;color:var(--lp-text);max-width:900px;text-wrap:balance;">The open-source<br><span class="r3-ag-hero-chip" style="display:inline-block;padding:0.02em 0.1em 0.08em;border-radius:10px;background:var(--hchip-bg);box-shadow:var(--hchip-shadow);font-family:var(--font-bitmap,'PP Mondwest',monospace);font-weight:400;line-height:1.06;color:var(--hchip-text);vertical-align:baseline;">agent</span> platform</h1><p class="r3-ag-sub" style="margin:0;font:400 16px/24px 'Inter', -apple-system, 'BlinkMacSystemFont', 'Segoe UI', 'Roboto', 'Helvetica Neue', 'Arial', sans-serif;color:var(--lp-body);max-width:620px;text-wrap:pretty;">Build agents and automations from natural language prompts. Work with them in the Agenta workspace, or deploy them to Slack, Discord, Teams, WhatsApp, Telegram or your website for your team and your clients.</p></div><div style="display:flex;gap:12px;"><Button variant="primary" href="https://cloud.agenta.ai/">Try for free</Button><Button variant="outline" href="https://docs.agenta.ai/" external>Read the docs</Button></div><div aria-label="Agenta workspace: a live agent run" data-lp-gate class="r3-ag-app-frame r3-ag-over-rail r3-i2-run" style="position:relative;z-index:6;width:min(1120px,100%);height:680px;border-radius:12px;border:1px solid var(--border);box-shadow:0 0 0 6px var(--muted), 0 0 0 7px var(--border);display:block;overflow:hidden;text-align:left;font-family:'Inter', -apple-system, 'BlinkMacSystemFont', 'Segoe UI', 'Roboto', 'Helvetica Neue', 'Arial', sans-serif;color:var(--foreground);background:var(--background)"><div class="r3-aw r3-aw-full"><aside class="r3-rs">
