<style is:global set:html={demoTheme} />

<script is:inline>
  // Sidebar rows open the interactive demo; they are plain divs, so add button semantics.
  (() => {
    const frame = document.querySelector(".r3-ag-app-frame");
    const live = document.querySelector(".lp-demo-live");
    const side = frame && frame.querySelector(".r3-rs");
    if (!frame || !live || !side) return;
    live.tabIndex = -1;
    const VIEWS = ["Home", "Agents", "Automations", "Skills", "Sessions"];
    const show = (on) => {
      frame.hidden = on;
      live.hidden = !on;
    };
    const go = (detail) => {
      window.__agDemoGo = detail;
      window.dispatchEvent(new CustomEvent("ag-demo-go", { detail }));
      show(true);
    };
    const target = (row) => {
      const label = row.textContent.trim();
      if (row.classList.contains("r3-rs-n")) {
        if (VIEWS.includes(label)) return () => go({ view: label.toLowerCase() });
        if (label === "Templates") return () => (location.href = "/marketplace");
        return null;
      }
      if (row.classList.contains("r3-rs-s") && !row.classList.contains("r3-on")) {
        // The live demo keeps the hero pane's open or hidden state.
        return () =>
          go({
            view: "playground",
            playgroundTask: label,
            configOpen: frame.querySelector(".ws-split")?.dataset.config !== "false",
          });
      }
      return null;
    };
    for (const row of side.querySelectorAll(".r3-rs-n, .r3-rs-s")) {
      const act = target(row);
      if (!act) continue;
      row.setAttribute("role", row.textContent.trim() === "Templates" ? "link" : "button");
      row.tabIndex = 0;
      row.dataset.lpGo = "";
      row.addEventListener("click", act);
      row.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          act();
          if (!live.hidden) live.focus();
        }
      });
    }
    window.addEventListener("ag-demo-live", () => show(false));
  })();
</script>
