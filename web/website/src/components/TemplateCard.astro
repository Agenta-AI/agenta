---
// One catalog card; the name link covers the card. Wrap cards in `.ag-tplgrid`.
import AppMark from "./AppMark.astro";
import AuthorMark from "./AuthorMark.astro";
import { appsOf, searchTextOf, templatePath } from "../lib/marketplace";
import type { WebsiteTemplate } from "../lib/templates";
import "../styles/marketplace.css";

interface Props {
  template: WebsiteTemplate;
  /** Catalog position, for the index's "Recommended" sort. */
  order?: number;
}

const { template, order } = Astro.props;
const apps = appsOf(template);
const shown = apps.slice(0, 3);
const more = apps.length - shown.length;
---

<article
  class="ag-tplcard"
  data-template-key={template.key}
  data-category={template.category}
  data-apps={apps.map((app) => app.slug).join(" ")}
  data-name={template.name}
  data-order={order}
  data-search={searchTextOf(template)}
>
  <div class="ag-tplcard__head">
    <div class="ag-appstack">
      {shown.map((app) => <AppMark app={app} />)}
    </div>
    {more > 0 && <span class="ag-tplcard__more">+{more}</span>}
  </div>
  <div class="ag-tplcard__text">
    {
      template.trigger && (
        <span class="ag-tplcard__trigger">
          <span class="ag-mkt-dot" aria-hidden="true" />
          {template.trigger}
        </span>
      )
    }
    <h3 class="ag-tplcard__title">
      <a href={templatePath(template.key)}>{template.name}</a>
    </h3>
    <p class="ag-tplcard__desc">{template.summary}</p>
  </div>
  <div class="ag-tplcard__foot">
    <span class="ag-tplcard__author">
      <AuthorMark author={template.author} />
      {template.author.name}
    </span>
  </div>
</article>

<style is:global>
  .ag-tplgrid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 16px;
  }
  .ag-tplcard {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-height: 250px;
    padding: 24px;
    border-radius: var(--radius-lg);
    background: var(--th-bg-1);
    box-shadow: 0 0 0 1px var(--th-border);
    box-sizing: border-box;
    transition:
      box-shadow 0.18s ease,
      transform 0.18s ease;
    --stack-ring: var(--th-bg-1);
  }
  .ag-tplcard:hover {
    box-shadow:
      0 0 0 1px var(--th-ctl-ring),
      var(--th-menu-shadow);
    transform: translateY(-2px);
  }
  @media (prefers-reduced-motion: reduce) {
    .ag-tplcard,
    .ag-tplcard:hover {
      transition: none;
      transform: none;
    }
  }
  .ag-tplcard__head {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .ag-tplcard__more {
    font: var(--text-caption);
    color: var(--th-text-mut);
  }
  .ag-tplcard__text {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .ag-tplcard__trigger {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font: var(--text-caption);
    color: var(--th-text-mut);
  }
  .ag-tplcard__title {
    margin: 0;
    font: 300 25px/1.2 var(--font-display);
    color: var(--th-text-hi);
  }
  .ag-tplcard__title a {
    color: inherit;
    text-decoration: none;
  }
  /* The name's link covers the whole card. */
  .ag-tplcard__title a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  @supports selector(:has(*)) {
    .ag-tplcard__title a:focus-visible {
      outline: none;
    }
    .ag-tplcard:has(.ag-tplcard__title a:focus-visible) {
      outline: 2px solid var(--th-text-hi);
      outline-offset: 2px;
    }
  }
  .ag-tplcard__desc {
    margin: 0;
    font: var(--text-body-sm);
    color: var(--th-text-body);
    text-wrap: pretty;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .ag-tplcard__foot {
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid var(--th-border-subtle);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .ag-tplcard__author {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font: var(--text-caption);
    color: var(--th-text-body);
  }

  @media (max-width: 767px) {
    .ag-tplgrid {
      grid-template-columns: minmax(0, 1fr);
    }
    .ag-tplcard {
      min-height: 0;
    }
  }
</style>
