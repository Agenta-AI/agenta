---
// One app's logo on its --brand-<slug> tile (initial on a neutral tile if no logo).
import type { TemplateApp } from "../lib/marketplace";

interface Props {
  app: TemplateApp;
  size?: number;
}
const { app, size } = Astro.props;
const vars = [
  size && `--appmark:${size}px;`,
  app.logo &&
    `--tile-bg:var(--brand-${app.slug});--tile-fg:var(--brand-${app.slug}-ink,var(--paper-0));`,
]
  .filter(Boolean)
  .join("");
---

<span
  class:list={["ag-appmark", app.logo && "ag-appmark--brand"]}
  title={app.name}
  style={vars || undefined}
>
  {
    app.logo ? (
      <span
        class="ag-appmark__logo"
        role="img"
        aria-label={app.name}
        style={`--logo:url(${app.logo});`}
      />
    ) : (
      <span class="ag-appmark__initial" role="img" aria-label={app.name}>
        {app.name.charAt(0).toUpperCase()}
      </span>
    )
  }
</span>

<style is:global>
  :root {
    --appmark: 34px;
  }
  .ag-appmark {
    width: var(--appmark);
    height: var(--appmark);
    border-radius: calc(var(--appmark) * 0.27);
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--tile-bg, var(--th-ctl-bg));
    box-shadow: inset 0 0 0 1px var(--th-ctl-ring);
  }
  .ag-appmark__logo {
    width: calc(var(--appmark) * 0.47);
    height: calc(var(--appmark) * 0.47);
    background: var(--tile-fg, var(--th-text-hi));
    opacity: 0.85;
    -webkit-mask: var(--logo) center / contain no-repeat;
    mask: var(--logo) center / contain no-repeat;
  }
  .ag-appmark--brand .ag-appmark__logo {
    opacity: 1;
  }
  .ag-appmark__initial {
    font: 600 calc(var(--appmark) * 0.36) / 1 var(--font-sans);
    color: var(--th-text-hi);
  }
  /* Overlapping row of marks; the ring matches the surface behind the stack. */
  .ag-appstack {
    display: flex;
    align-items: center;
    padding-left: calc(var(--appmark) * 0.28);
    isolation: isolate;
  }
  /* Earlier marks sit on top so no mark covers the logo before it. */
  .ag-appstack .ag-appmark {
    position: relative;
    z-index: 1;
    margin-left: calc(var(--appmark) * -0.28);
    background: var(--tile-bg, var(--th-bg-2));
    box-shadow:
      0 0 0 2px var(--stack-ring, var(--th-bg-1)),
      inset 0 0 0 1px var(--th-ctl-ring);
  }
  .ag-appstack .ag-appmark:nth-child(1) {
    z-index: 5;
  }
  .ag-appstack .ag-appmark:nth-child(2) {
    z-index: 4;
  }
  .ag-appstack .ag-appmark:nth-child(3) {
    z-index: 3;
  }
  .ag-appstack .ag-appmark:nth-child(4) {
    z-index: 2;
  }
</style>
