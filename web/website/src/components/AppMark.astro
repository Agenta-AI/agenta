---
// One app's mark in a small tile (template cards, the template page sidebar).
// Logos are monochrome SVGs drawn through a CSS mask in the theme's text
// colour; an app without a hosted logo shows its initial.
import type { TemplateApp } from "../lib/marketplace";

interface Props {
  app: TemplateApp;
}
const { app } = Astro.props;
---

<span class="ag-appmark" title={app.name}>
  {
    app.logo ? (
      <span
        class="ag-appmark__logo"
        role="img"
        aria-label={app.name}
        style={`--logo:url(${app.logo});`}
      />
    ) : (
      <span class="ag-appmark__initial" role="img" aria-label={app.name}>
        {app.name.charAt(0).toUpperCase()}
      </span>
    )
  }
</span>

<style is:global>
  .ag-appmark {
    width: 34px;
    height: 34px;
    border-radius: 9px;
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--th-ctl-bg);
    box-shadow: inset 0 0 0 1px var(--th-ctl-ring);
  }
  .ag-appmark__logo {
    width: 16px;
    height: 16px;
    background: var(--th-text-hi);
    opacity: 0.85;
    -webkit-mask: var(--logo) center / contain no-repeat;
    mask: var(--logo) center / contain no-repeat;
  }
  .ag-appmark__initial {
    font: 600 12px/1 var(--font-sans);
    color: var(--th-text-hi);
  }
</style>
