---
import { getCollection } from "astro:content";
import Button from "./Button.astro";
import TemplatePreviewArt from "./nav/TemplatePreviewArt.astro";
import ResourcePreviewArt from "./nav/ResourcePreviewArt.astro";
import { templates, templateByKey } from "../lib/templates";
import { NAV_TEMPLATE_PICKS } from "../lib/landingTemplates";
import { byDateDesc } from "../lib/blog";
import "../styles/landing/tokens.css";
import "../styles/nav-mega.css";
// SiteNav — the single nav for the whole site (landing + inner pages).
// `sticky` gates the scroll-pill machinery (rAF loop + .nav-scrolled styles +
// wordmark clip): the landing passes it; every other page renders the identical
// bar as a static top bar. CTA + link destinations match live agenta.ai.
interface Props {
  sticky?: boolean;
}
const { sticky = false } = Astro.props;

const BOOK_DEMO = "https://cal.com/mahmoud-mabrouk-ogzgey/demo?duration=30";
const GET_STARTED = "https://cloud.agenta.ai/";

const pricing = { label: "Pricing", href: "/pricing" };

const templateGroups = NAV_TEMPLATE_PICKS.map((g) => ({
  ...g,
  href: `/marketplace?category=${encodeURIComponent(g.category)}`,
  count: templates.filter((t) => t.category === g.category).length,
  items: g.keys
    .map((k) => templateByKey(k))
    .filter((t): t is NonNullable<typeof t> => !!t)
    .map((t) => ({ key: t.key, name: t.name, summary: t.summary, href: `/marketplace/${t.key}` })),
}));
const templateItems = templateGroups.flatMap((g) => g.items);

// Resources menu.
const latestPost = (await getCollection("posts")).sort(byDateDesc)[0];
type ResourceKey = "blog" | "docs" | "changelog" | "slack" | "github" | "x" | "linkedin" | "contrib";
type ResourceItem = { key: ResourceKey; label: string; href: string; external?: boolean };
const resourceGroups: { label: string; items: ResourceItem[] }[] = [
  {
    label: "Learn",
    items: [
      { key: "blog", label: "Blog", href: "/blog" },
      { key: "docs", label: "Docs", href: "https://docs.agenta.ai/", external: true },
      { key: "changelog", label: "Changelog", href: "https://agenta.ai/docs/changelog/main", external: true },
    ],
  },
  {
    label: "Community",
    items: [
      { key: "slack", label: "Slack community", href: "https://join.slack.com/t/agenta-hq/shared_invite/zt-37pnbp5s6-mbBrPL863d_oLB61GSNFjw", external: true },
      { key: "github", label: "GitHub", href: "https://github.com/Agenta-AI/agenta", external: true },
      { key: "x", label: "X", href: "https://x.com/agenta_ai", external: true },
      { key: "linkedin", label: "LinkedIn", href: "https://www.linkedin.com/company/agenta-ai", external: true },
      { key: "contrib", label: "Contribute a template", href: "https://github.com/Agenta-AI/agenta", external: true },
    ],
  },
];
const resourceItems = resourceGroups.flatMap((g) => g.items);
const ext = (external?: boolean) => (external ? { target: "_blank", rel: "noopener" } : {});
const arrow = `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>`;

const chevron = `<svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2.5 4.25 6 7.75l3.5-3.5" stroke="currentColor" stroke-width="1.5"/></svg>`;

// Theme switcher icons (lucide-style, currentColor): monitor = system,
// sun = light, moon = dark. The button cycles system → light → dark.
const icoMonitor = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/></svg>`;
const icoSun = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>`;
const icoMoon = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>`;
// Framer's nav item: 36px tall, 8px/12px padding, 8px radius, 14px/500 Inter
// with 0.02em tracking, in ink-900.
const linkStyle =
  "display:inline-flex;align-items:center;gap:5px;height:36px;padding:8px 12px;border-radius:8px;font:var(--text-label);letter-spacing:0.02em;color:var(--th-nav-text);cursor:pointer;text-decoration:none;";
const triggerStyle = linkStyle + "border:none;background:transparent;";
---

<!-- Nav is a fixed-geometry sticky shell (height stable, vertical center fixed);
     only .ag-nav-inner animates — it narrows into a centered pill and drops by
     --nav-pill-inset while brand (left) and CTAs (right) ride its edges inward.
     The center links live in a SEPARATE layer absolutely centered on the shell;
     on scroll they ride down by the same inset (dy only, dx stays 0) so they
     never shift horizontally. See the nav-pill block in global.css. -->
<nav class="ag-navshell" data-pill={sticky ? "" : undefined}>
  <span class="ag-nav-rule ag-nav-rule-l" aria-hidden="true"></span>
  <span class="ag-nav-rule ag-nav-rule-r" aria-hidden="true"></span>
  <div class="ag-nav-inner">
    <a class="ag-brand" href="/" aria-label="Agenta home">
      <img
        class="th-dark-only"
        src="/logos/Agenta-logo-full-dark.svg"
        alt="Agenta"
        style="height:23px;max-width:none;display:block;"
      />
      <img
        class="th-light-only"
        src="/logos/Agenta-logo-full-light.svg"
        alt="Agenta"
        style="height:23px;max-width:none;display:block;"
      />
    </a>

    <div class="ag-navcta" style="display:flex;align-items:center;gap:12px;">
      <button
        class="ag-theme-btn"
        data-theme-toggle
        aria-label="Switch theme"
        title="Theme"
      >
        <span data-ico="system" set:html={icoMonitor} />
        <span data-ico="light" set:html={icoSun} />
        <span data-ico="dark" set:html={icoMoon} />
      </button>
      <span class="ag-navsep" aria-hidden="true"></span>
      <Button variant="outline" href={BOOK_DEMO}>Book a demo</Button>
      <Button variant="primary" href={GET_STARTED}>Get started</Button>
    </div>

    <button
      class="ag-menu"
      id="ag-menu-toggle"
      aria-label="Open menu"
      aria-expanded="false"
      style="align-items:center;justify-content:center;width:38px;height:34px;border:none;border-radius:8px;background:var(--th-ctl-bg);box-shadow:inset 0 0 0 1px var(--th-ctl-ring);cursor:pointer;padding:0;color:var(--th-ctl-text);"
    >
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none"
        ><path
          d="M2 5h14M2 9h14M2 13h14"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"></path></svg
      >
    </button>
  </div>

  <div class="ag-navlinks">
    <a class="ag-navlink" href={pricing.href} style={linkStyle}>{pricing.label}</a>

    <div class="ag-navdd" data-mega>
      <a class="ag-navlink" href="/marketplace" style={linkStyle} aria-haspopup="true" aria-expanded="false" aria-controls="ag-mega-templates">
        Templates
      </a>
      <div class="ag-mega ag-art" id="ag-mega-templates" role="region" aria-label="Templates">
        <div class="ag-mega__cols">
          {
            templateGroups.map((g) => (
              <div class="ag-mega__col">
                <a class="ag-mega__head" href={g.href}>
                  {g.label}
                  <em>{g.count}</em>
                  <span set:html={arrow} />
                </a>
                {g.items.map((t) => (
                  <a class="ag-mega__item" href={t.href} data-preview={t.key}>
                    {t.name}
                  </a>
                ))}
              </div>
            ))
          }
        </div>
        <div class="ag-mega__side" aria-hidden="true">
          {
            templateItems.map((t, i) => (
              <div class="ag-mega__pv spv" data-preview-panel={t.key} hidden={i > 0}>
                <TemplatePreviewArt templateKey={t.key} />
                <h4>{t.name}</h4>
                <p>{t.summary}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <div class="ag-navdd" data-mega>
      <button class="ag-navlink" type="button" style={triggerStyle} aria-expanded="false" aria-controls="ag-mega-resources">
        Resources
      </button>
      <div class="ag-mega ag-mega--narrow ag-art" id="ag-mega-resources" role="region" aria-label="Resources">
        <div class="ag-mega__cols">
          {
            resourceGroups.map((g) => (
              <div class="ag-mega__col">
                <p class="ag-mega__head">{g.label}</p>
                {g.items.map((it) => (
                  <a class="ag-mega__item" href={it.href} data-preview={it.key} {...ext(it.external)}>
                    {it.label}
                  </a>
                ))}
              </div>
            ))
          }
        </div>
        <div class="ag-mega__side" aria-hidden="true">
          {
            resourceItems.map((it, i) => (
              <div class="ag-mega__pv rv" data-preview-panel={it.key} hidden={i > 0}>
                <ResourcePreviewArt item={it.key} post={latestPost} />
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</nav>

<noscript>
  <style>
    /* Without JavaScript the hamburger cannot open the menu, so phones show
       the menu inline under the bar instead. */
    @media (max-width: 860px) {
      #ag-menu-toggle { display: none !important; }
      .ag-mobile-menu { display: flex !important; position: static !important; }
    }
  </style>
</noscript>

<div
  class="ag-mobile-menu"
  id="ag-mobile-menu"
  style="flex-direction:column;gap:2px;padding:12px 16px 16px;background:var(--th-chrome);border:1px solid var(--th-border-subtle);border-top:none;margin-top:-1px;"
>
  <a class="ag-mm-link" href={pricing.href}>{pricing.label}</a>
  <details class="ag-mm-group">
    <summary class="ag-mm-link">Templates<span class="ag-mm-chev" set:html={chevron} /></summary>
    <div class="ag-mm-panel ag-art">
      <div class="ag-mm-chips" role="tablist" aria-label="Template categories">
        {
          templateGroups.map((g, i) => (
            <button type="button" class="ag-mm-chip" role="tab" id={`ag-mm-tab-${i}`} aria-controls={`ag-mm-rail-${i}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} data-mm-tab={i}>
              {g.label}<em>{g.count}</em>
            </button>
          ))
        }
      </div>
      {
        templateGroups.map((g, i) => (
          <div class="ag-mm-tabpanel" role="tabpanel" id={`ag-mm-rail-${i}`} aria-labelledby={`ag-mm-tab-${i}`} hidden={i > 0}>
            <div class="ag-mm-rail">
              {g.items.map((t) => (
                <a class="ag-mm-card spv" href={t.href}>
                  <TemplatePreviewArt templateKey={t.key} />
                  <h4>{t.name}</h4>
                  <p>{t.summary}</p>
                </a>
              ))}
            </div>
            <a class="ag-mm-more" href={g.href}>All {g.label} templates<span set:html={arrow} /></a>
          </div>
        ))
      }
      <a class="ag-mm-all" href="/marketplace">See all {templates.length} templates<span set:html={arrow} /></a>
    </div>
  </details>
  <details class="ag-mm-group">
    <summary class="ag-mm-link">Resources<span class="ag-mm-chev" set:html={chevron} /></summary>
    <div class="ag-mm-panel ag-art">
      <div class="ag-mm-cols">
        {
          resourceGroups.map((g) => (
            <div class="ag-mm-col">
              <p class="ag-mm-head">{g.label}</p>
              {g.items.map((it) => <a class="ag-mm-item" href={it.href} {...ext(it.external)}>{it.label}</a>)}
            </div>
          ))
        }
      </div>
      {
        latestPost && (
          <a class="ag-mm-post rv" href={`/blog/${latestPost.id}`}>
            <ResourcePreviewArt item="blog" post={latestPost} />
          </a>
        )
      }
    </div>
  </details>
  <div style="display:flex;gap:10px;margin-top:10px;">
    <button
      class="ag-theme-btn"
      data-theme-toggle
      aria-label="Switch theme"
      title="Theme"
      style="width:42px;height:42px;flex:0 0 auto;"
    >
      <span data-ico="system" set:html={icoMonitor} />
      <span data-ico="light" set:html={icoSun} />
      <span data-ico="dark" set:html={icoMoon} />
    </button>
    <Button variant="outline" href={BOOK_DEMO} block>Book a demo</Button>
    <Button variant="primary" href={GET_STARTED} block>Get started</Button>
  </div>
</div>

<script>
  // Theme switcher: cycles system → light → dark. The pre-paint resolver in
  // Base.astro owns resolution/persistence (window.__agTheme); here we only
  // cycle the preference and mirror it onto the buttons (data-pref drives
  // which icon shows, via CSS in global.css).
  {
    const NEXT: Record<string, string> = { system: "light", light: "dark", dark: "system" };
    const LABEL: Record<string, string> = {
      system: "Theme: system — switch to light",
      light: "Theme: light — switch to dark",
      dark: "Theme: dark — switch to system",
    };
    const api = (window as any).__agTheme;
    const buttons = document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]");
    const sync = () => {
      const pref = api?.get() ?? "system";
      buttons.forEach((b) => {
        b.dataset.pref = pref;
        b.setAttribute("aria-label", LABEL[pref]);
        b.title = LABEL[pref];
      });
    };
    buttons.forEach((b) =>
      b.addEventListener("click", () => {
        api?.set(NEXT[api?.get() ?? "system"]);
      }),
    );
    document.addEventListener("ag-theme-change", sync);
    sync();
  }

  // Lightweight hamburger toggle (no framework). Replaces the DC menuOpen state.
  const toggle = document.getElementById("ag-menu-toggle");
  const menu = document.getElementById("ag-mobile-menu");
  const closeMenu = () => {
    // If focus is on a menu link when it hides (link tap, or resize to desktop),
    // return it to the toggle so keyboard focus isn't dropped to <body>.
    const focusInMenu = menu?.contains(document.activeElement) ?? false;
    menu?.classList.remove("is-open");
    toggle?.setAttribute("aria-expanded", "false");
    if (focusInMenu) toggle?.focus();
  };
  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("is-open");
    toggle.setAttribute("aria-expanded", open ? "true" : "false");
  });
  document.addEventListener("pointerdown", (e) => {
    const t = e.target as Node;
    if (menu?.classList.contains("is-open") && !menu.contains(t) && !toggle?.contains(t)) closeMenu();
  });
  // Close when a menu entry is tapped (in-page anchors and same-tab navigations
  // wouldn't otherwise dismiss the now-fixed overlay).
  menu?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", closeMenu),
  );
  // Never leave the mobile overlay open once the layout returns to desktop.
  window.addEventListener(
    "resize",
    () => {
      if (window.innerWidth > 860) closeMenu();
    },
    { passive: true },
  );

  // Mega menus. Hover (with an intent delay) opens a menu. "Templates" is also
  // a link: a mouse click goes to /marketplace, a first tap on a touch screen
  // opens the menu and a second tap follows the link. From the keyboard, the
  // Down arrow opens a menu (Enter also toggles Resources); Escape and taps
  // outside close it. The item under the pointer or focus picks the preview.
  {
    const menus = [...document.querySelectorAll<HTMLElement>(".ag-navdd[data-mega]")];
    const finePointer = matchMedia("(hover: hover) and (pointer: fine)");
    const triggerOf = (dd: HTMLElement) => dd.querySelector<HTMLElement>(":scope > .ag-navlink");
    const timers = new Map<HTMLElement, number>();
    const schedule = (dd: HTMLElement, fn: () => void, ms: number) => {
      clearTimeout(timers.get(dd));
      timers.set(dd, window.setTimeout(fn, ms));
    };
    const pick = (panel: HTMLElement, item: HTMLElement, byUser = true) => {
      const key = item.dataset.preview;
      panel.querySelectorAll<HTMLElement>("[data-preview]").forEach((el) => el.toggleAttribute("data-active", el === item));
      panel.querySelectorAll<HTMLElement>("[data-preview-panel]").forEach((el) => {
        el.hidden = el.dataset.previewPanel !== key;
      });
      if (byUser) panel.setAttribute("data-picked", "");
    };
    const setOpen = (dd: HTMLElement, open: boolean, by?: "hover" | "click") => {
      if (by) dd.dataset.openedBy = by;
      if (open === dd.hasAttribute("data-open")) return;
      dd.toggleAttribute("data-open", open);
      triggerOf(dd)?.setAttribute("aria-expanded", String(open));
      if (open) {
        const panel = dd.querySelector<HTMLElement>(".ag-mega");
        const first = panel?.querySelector<HTMLElement>("[data-preview]");
        panel?.removeAttribute("data-picked");
        if (panel && first) pick(panel, first, false);
      }
    };
    const closeAll = (except?: HTMLElement) => menus.forEach((m) => m !== except && setOpen(m, false));
    menus.forEach((dd) => {
      const trigger = triggerOf(dd);
      const panel = dd.querySelector<HTMLElement>(".ag-mega");
      const isLink = trigger instanceof HTMLAnchorElement;
      trigger?.addEventListener("click", (e) => {
        clearTimeout(timers.get(dd));
        const isOpen = dd.hasAttribute("data-open");
        if (isLink) {
          if (finePointer.matches || isOpen) return;
          e.preventDefault();
          closeAll(dd);
          setOpen(dd, true, "click");
          return;
        }
        // A click on a menu that hover just opened keeps it open.
        const open = !isOpen || dd.dataset.openedBy === "hover";
        closeAll(dd);
        setOpen(dd, open, "click");
      });
      trigger?.addEventListener("keydown", (e) => {
        if (e.key !== "ArrowDown") return;
        e.preventDefault();
        setOpen(dd, true, "click");
        panel?.querySelector<HTMLElement>("a")?.focus();
      });
      dd.addEventListener("mouseenter", () => {
        if (!finePointer.matches) return;
        if (dd.hasAttribute("data-open")) {
          clearTimeout(timers.get(dd));
          return;
        }
        schedule(dd, () => {
          closeAll(dd);
          setOpen(dd, true, "hover");
        }, menus.some((m) => m.hasAttribute("data-open")) ? 0 : 80);
      });
      dd.addEventListener("mouseleave", () => {
        if (!finePointer.matches) return;
        schedule(dd, () => {
          // Keep a menu open while keyboard focus is inside it.
          if (dd.matches(":has(:focus-visible)")) return;
          setOpen(dd, false);
        }, 120);
      });
      dd.addEventListener("focusout", () =>
        requestAnimationFrame(() => {
          if (!dd.contains(document.activeElement)) setOpen(dd, false);
        }),
      );
      panel?.querySelectorAll<HTMLElement>("[data-preview]").forEach((item) => {
        item.addEventListener("mouseenter", () => pick(panel, item));
        item.addEventListener("focus", () => {
          setOpen(dd, true, dd.hasAttribute("data-open") ? undefined : "click");
          pick(panel, item);
        });
      });
    });
    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      const open = menus.find((m) => m.hasAttribute("data-open"));
      if (!open) return;
      const hadFocus = open.contains(document.activeElement);
      setOpen(open, false);
      if (hadFocus) triggerOf(open)?.focus();
    });
    // pointerdown, not click: iOS does not send click for taps on plain content.
    document.addEventListener("pointerdown", (e) => {
      if (!menus.some((m) => m.contains(e.target as Node))) closeAll();
    });
  }

  // Mobile menu: template category chips switch the card rail.
  {
    const tabs = [...document.querySelectorAll<HTMLButtonElement>("[data-mm-tab]")];
    const select = (tab: HTMLButtonElement, focus = false) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute("aria-controls") ?? "");
        if (panel) panel.hidden = !on;
      });
      if (focus) tab.focus();
      tab.scrollIntoView({ block: "nearest", inline: "nearest" });
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(tab));
      tab.addEventListener("keydown", (e) => {
        const step = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
        if (!step) return;
        e.preventDefault();
        select(tabs[(i + step + tabs.length) % tabs.length], true);
      });
    });
  }


  // Nav-pill: landing only. The rAF loop toggles `.nav-scrolled` on <html> past
  // 24px so the sticky bar floats into the glass pill (styles in global.css). It
  // runs ONLY when a `nav[data-pill]` is present — inner pages render a static
  // bar with no pill, so the loop never starts and `.nav-scrolled` never toggles.
  const root = document.documentElement;
  if (document.querySelector("nav[data-pill]") && !(window as any).__agNavPill) {
    (window as any).__agNavPill = true;
    let raf = 0;
    const measure = () => {
      raf = 0;
      const on = (window.scrollY || root.scrollTop || 0) > 24;
      if (on !== root.classList.contains("nav-scrolled")) {
        root.classList.toggle("nav-scrolled", on);
      }
    };
    const schedule = () => {
      if (!raf) raf = requestAnimationFrame(measure);
    };
    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", schedule, { passive: true });
    measure();
  }
</script>
