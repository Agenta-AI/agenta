---
// One FAQ row (native <details>) that animates open and closed; tint the icon with `--faq-icon`.
interface Props {
  question: string;
  open?: boolean;
}
const { question, open = false } = Astro.props;
---

<details class="faq-item" open={open}>
  <summary>
    <span class="faq-q">{question}</span>
    <svg class="faq-icon" width="22" height="22" viewBox="0 0 24 24" fill="none">
      <path
        d="M12 5v14M5 12h14"
        stroke="var(--faq-icon, var(--th-text-body))"
        stroke-width="1.5"
        stroke-linecap="round"></path>
    </svg>
  </summary>
  <p class="faq-a"><slot /></p>
</details>

<script>
  const DURATION = 260;
  const reduced = matchMedia("(prefers-reduced-motion: reduce)");
  for (const item of document.querySelectorAll<HTMLDetailsElement>("details.faq-item")) {
    const summary = item.querySelector("summary");
    if (!summary) continue;
    let running: Animation | null = null;
    const closedHeight = () => {
      const style = getComputedStyle(item);
      return (
        summary.offsetHeight +
        parseFloat(style.paddingTop) +
        parseFloat(style.paddingBottom) +
        parseFloat(style.borderTopWidth) +
        parseFloat(style.borderBottomWidth)
      );
    };
    summary.addEventListener("click", (event) => {
      if (reduced.matches) return;
      event.preventDefault();
      const start = item.offsetHeight;
      running?.cancel();
      // A click mid-close reopens from wherever the row is.
      const opening = !item.open || item.dataset.state === "closing";
      item.dataset.state = opening ? "opening" : "closing";
      item.open = true;
      const end = opening ? item.offsetHeight : closedHeight();
      const animation = item.animate(
        { height: [`${start}px`, `${end}px`] },
        { duration: DURATION, easing: "cubic-bezier(0.22, 1, 0.36, 1)" },
      );
      running = animation;
      animation.onfinish = () => {
        running = null;
        if (!opening) item.open = false;
        delete item.dataset.state;
      };
    });
  }
</script>

<style>
  .faq-item {
    overflow: hidden;
    border-top: 1px solid var(--th-border);
    padding: 24px 0;
  }
  .faq-item summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-q {
    font: 300 20px/1.3 var(--font-display, "GT Alpina", serif);
    color: var(--th-text-hi);
  }
  .faq-icon {
    flex: 0 0 auto;
    margin-top: 2px;
    transition: transform 0.16s ease;
  }
  .faq-item[open]:not([data-state="closing"]) .faq-icon {
    transform: rotate(45deg);
  }
  .faq-a {
    margin: 12px 0 0;
    max-width: 680px;
    font: var(--text-body-md);
    color: var(--th-text-body);
  }
  .faq-a {
    transition: opacity 0.2s ease;
  }
  .faq-item[open]:not([data-state="closing"]) .faq-a {
    animation: accordion-in 0.2s ease both;
  }
  .faq-item[data-state="closing"] .faq-a {
    opacity: 0;
  }
</style>
