---
import Site from "../layouts/Site.astro";
import "../styles/landing/tokens.css";
import "../styles/landing/base.css";
import LandingHero from "../components/landing/LandingHero.astro";
import WorkInChat from "../components/landing/WorkInChat.astro";
import WorkWithAgents from "../components/landing/WorkWithAgents.astro";
import TemplatesShowcase from "../components/landing/TemplatesShowcase.astro";
import EverythingYouNeed from "../components/landing/EverythingYouNeed.astro";
import StayInControl from "../components/landing/StayInControl.astro";
import SelfHost from "../components/landing/SelfHost.astro";
import "../styles/landing/responsive.css";

// Organization structured data (schema.org JSON-LD). Emitted only on the landing
// page so crawlers attach the knowledge-panel entity to the site root.
const orgJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Agenta",
  url: "https://agenta.ai",
  logo: new URL("/logos/Agenta-logo-full-dark.svg", Astro.site).toString(),
  description:
    "The open-source agent platform for building, running and deploying AI agents and automations.",
  sameAs: [
    "https://github.com/Agenta-AI/agenta",
    "https://www.linkedin.com/company/agenta-ai/",
    "https://twitter.com/agenta_ai",
    "https://www.youtube.com/@agentaAI",
  ],
};
---

<Site
  cta={{
    eyebrow: "Get started",
    title: "Start building your first agent",
    body: "Pick one job someone repeats every week. Describe it, connect the apps it needs, and the agent runs it on its own.",
    secondaryLabel: "Read the docs",
    secondaryHref: "https://docs.agenta.ai/",
  }}
  sticky
  title="Agenta — The open-source agent platform"
  description="Agenta is the open-source agent platform. Build agents and automations by chatting with them, work with them in the Agenta workspace, or deploy them to Slack, Discord, Teams, WhatsApp, Telegram or your website. Self-hosted or in the cloud."
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(orgJsonLd)}
    />
  </Fragment>

  <div class="lp">
    <LandingHero />
    <WorkInChat />
    <WorkWithAgents />
    <TemplatesShowcase />
    <EverythingYouNeed />
    <StayInControl />
    <SelfHost />
  </div>
  <script is:inline>
    // Pause each section's animations while it is off screen.
    (() => {
      const root = document.querySelector(".lp");
      if (!root || !("IntersectionObserver" in window)) return;
      root.setAttribute("data-lp-anim", "");
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) e.target.toggleAttribute("data-lp-in", e.isIntersecting);
        },
        { rootMargin: "0px 0px -15% 0px" },
      );
      for (const section of root.children) if (section.tagName !== "SCRIPT") io.observe(section);
      // [data-lp-gate] demos start only when most of the demo is on screen.
      const gate = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            const seen = e.intersectionRect.height;
            const viewH = e.rootBounds?.height ?? innerHeight;
            let need = 0.6 * Math.min(e.boundingClientRect.height, viewH);
            // A demo that starts on the first screen (the hero) can never show 60%
            // before the visitor scrolls, so it needs only what that screen shows.
            const firstScreen = viewH - (e.boundingClientRect.top + scrollY);
            if (firstScreen > 0) need = Math.min(need, firstScreen);
            e.target.toggleAttribute("data-lp-in", e.isIntersecting && seen >= need);
          }
        },
        { threshold: Array.from({ length: 21 }, (_, i) => i / 20) },
      );
      for (const el of root.querySelectorAll("[data-lp-gate]")) gate.observe(el);
    })();
  </script>
  <script is:inline>
    // Scale fixed-size mock-ups ([data-lp-fit]) to their column; runs before first paint.
    (() => {
      const items = [...document.querySelectorAll("[data-lp-fit]")];
      const fit = () => {
        for (const el of items) {
          // A section can lower the design width per breakpoint with --lp-fit-design.
          const design = Number(getComputedStyle(el).getPropertyValue("--lp-fit-design")) || Number(el.dataset.lpFit);
          let parent = el.parentElement;
          while (parent && getComputedStyle(parent).display === "contents") parent = parent.parentElement;
          if (!parent || !design) continue;
          const cs = getComputedStyle(parent);
          const avail = parent.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
          const st = el.style;
          st.removeProperty("transform");
          st.removeProperty("margin-right");
          st.removeProperty("margin-bottom");
          if (avail > 0 && avail < design) {
            // transform, not zoom: WebKit clamps small text inside zoom.
            const scale = avail / design;
            el.dataset.lpFitted = "";
            st.setProperty("--lp-fit-w", design + "px");
            st.transform = `scale(${scale})`;
            st.marginRight = `${-design * (1 - scale)}px`;
            st.marginBottom = `${-el.offsetHeight * (1 - scale)}px`;
          } else {
            delete el.dataset.lpFitted;
          }
        }
      };
      // Scale the sticky stage's grid down on screens shorter than the design.
      const stage = document.querySelector(".sx-hiw .hw-stage");
      const grid = stage?.querySelector(".hw-grid");
      const head = stage?.querySelector(".hw-hd");
      const fitStage = () => {
        if (!stage || !grid || !head) return;
        grid.style.removeProperty("transform");
        grid.style.removeProperty("margin-bottom");
        if (innerWidth <= 860) return;
        const hs = getComputedStyle(head);
        const ss = getComputedStyle(stage);
        const pad = parseFloat(ss.paddingTop) + parseFloat(ss.paddingBottom);
        const avail = stage.clientHeight - pad - head.offsetHeight - parseFloat(hs.marginBottom);
        const natural = grid.offsetHeight;
        if (avail > 0 && natural > avail) {
          const scale = Math.max(0.6, avail / natural);
          grid.style.transformOrigin = "top center";
          grid.style.transform = `scale(${scale})`;
          grid.style.marginBottom = `${-natural * (1 - scale)}px`;
        }
      };
      const fitAll = () => { fit(); fitStage(); };
      fitAll();
      document.fonts?.ready.then(fitAll);
      addEventListener("load", fitAll, { once: true });
      let frame = 0;
      addEventListener("resize", () => {
        if (!frame) frame = requestAnimationFrame(() => { frame = 0; fitAll(); });
      }, { passive: true });
    })();
  </script>
</Site>
