---
// One template at /marketplace/<key>, per the "Templates Handoff" design (E):
// split hero, a body with a sticky sidebar, the yellow CTA band and related
// templates. Values come from the generated catalog. Fields the catalog lacks
// follow the handoff's fallbacks: the section is hidden or generated.
import type { GetStaticPaths } from "astro";
import Section from "../../components/Section.astro";
import Site from "../../layouts/Site.astro";
import Badge from "../../components/Badge.astro";
import Button from "../../components/Button.astro";
import CtaBand from "../../components/CtaBand.astro";
import AppMark from "../../components/AppMark.astro";
import TriggerPill from "../../components/TriggerPill.astro";
import ExampleOutput from "../../components/ExampleOutput.astro";
import {
  USE_IT_FOR_FREE_LABEL,
  templates,
  useItForFreeUrl,
  type WebsiteTemplate,
} from "../../lib/templates";
import {
  MARKETPLACE_NAME,
  MARKETPLACE_PATH,
  appsOf,
  authorPath,
  ctaHeadlineOf,
  howItWorksOf,
  initialsOf,
  relatedTemplatesOf,
  renderableMedia,
  requirementsOf,
  setupStepsOf,
  templatePath,
} from "../../lib/marketplace";

export const getStaticPaths = (() =>
  templates.map((template) => ({
    params: { key: template.key },
    props: { template },
  }))) satisfies GetStaticPaths;

const { template } = Astro.props as { template: WebsiteTemplate };
const cta = useItForFreeUrl(template.key);
const apps = appsOf(template);
const media = renderableMedia(template.media, template.name);
const [heroMedia, ...moreMedia] = media;
const example = template.example ?? null;
// No media: the example moves into the hero (6a). Neither: one column (6b).
const heroExample = heroMedia ? null : example;
const heroSplit = Boolean(heroMedia || heroExample);
const steps = howItWorksOf(template);
const setup = setupStepsOf(template);
const requirements = requirementsOf(template);
const related = relatedTemplatesOf(template, templates);
const isAgenta = template.author.id === "agenta";
---

<Site
  title={`${template.name} — ${MARKETPLACE_NAME}`}
  description={template.summary}
  showCta={false}
>
  <Section class="ag-tpl-hero" data-screen-label="Hero">
    <nav class="ag-tpl-crumb" aria-label="Breadcrumb">
      <a href={MARKETPLACE_PATH}>{MARKETPLACE_NAME}</a>
      <svg width="10" height="10" viewBox="0 0 12 12" fill="none" aria-hidden="true"
        ><path d="M4 2.5 8 6l-4 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
        ></path></svg
      >
      <span aria-current="page">{template.name}</span>
    </nav>
    <div class:list={["ag-tpl-hero__grid", heroSplit && "ag-tpl-hero__grid--split"]}>
      <div class="ag-tpl-hero__copy">
        <Badge>{template.category}</Badge>
        <h1 class="ag-tpl-hero__title">{template.name}</h1>
        <p class="ag-tpl-hero__summary">{template.summary}</p>
        <div class="ag-tpl-hero__actions">
          <Button variant="contrast" href={cta}>{USE_IT_FOR_FREE_LABEL}</Button>
        </div>
        {
          template.trigger && (
            <TriggerPill>{template.trigger}</TriggerPill>
          )
        }
        {
          !heroSplit && apps.length > 0 && (
            <div class="ag-tpl-apps">
              {apps.map((app) => <AppMark app={app} />)}
            </div>
          )
        }
      </div>

      {
        heroMedia && (
          <figure class="ag-tpl-media">
            {heroMedia.kind === "image" && (
              <img src={heroMedia.url} alt={heroMedia.alt} decoding="async" />
            )}
            {heroMedia.kind === "youtube" && (
              <iframe
                src={heroMedia.embedUrl}
                title={heroMedia.alt}
                loading="lazy"
                allow="accelerometer; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              />
            )}
            {heroMedia.kind === "video" && (
              <video controls preload="metadata" poster={heroMedia.posterUrl} aria-label={heroMedia.alt}>
                <source src={heroMedia.url} />
              </video>
            )}
            {heroMedia.caption && <figcaption>{heroMedia.caption}</figcaption>}
          </figure>
        )
      }
      {
        heroExample && (
          <div class="ag-tpl-panel">
            <ExampleOutput name={template.name} example={heroExample} />
          </div>
        )
      }
    </div>
  </Section>

  <Section class="ag-tpl-body" data-screen-label="Body">
    <div class="ag-tpl-body__grid">
      <div class="ag-tpl-main">
        <section class="ag-tpl-block">
          <h2>Overview</h2>
          <p>{template.description}</p>
          {
            moreMedia.map((item) =>
              item.kind === "image" ? (
                <figure class="ag-tpl-media ag-tpl-media--inline">
                  <img src={item.url} alt={item.alt} loading="lazy" decoding="async" />
                  {item.caption && <figcaption>{item.caption}</figcaption>}
                </figure>
              ) : item.kind === "youtube" ? (
                <figure class="ag-tpl-media ag-tpl-media--inline">
                  <iframe
                    src={item.embedUrl}
                    title={item.alt}
                    loading="lazy"
                    allow="accelerometer; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                  />
                  {item.caption && <figcaption>{item.caption}</figcaption>}
                </figure>
              ) : (
                <figure class="ag-tpl-media ag-tpl-media--inline">
                  <video controls preload="metadata" poster={item.posterUrl} aria-label={item.alt}>
                    <source src={item.url} />
                  </video>
                  {item.caption && <figcaption>{item.caption}</figcaption>}
                </figure>
              ),
            )
          }
        </section>

        {
          steps.length > 0 && (
            <section class="ag-tpl-block">
              <h2>How it works</h2>
              <ol class="ag-tpl-steps">
                {steps.map((step, i) => (
                  <li>
                    <span class="ag-tpl-num">{i + 1}</span>
                    {step}
                  </li>
                ))}
              </ol>
            </section>
          )
        }

        {
          heroMedia && example && (
            <section class="ag-tpl-block">
              <h2>Example output</h2>
              <ExampleOutput name={template.name} example={example} />
            </section>
          )
        }

        <section class="ag-tpl-block">
          <h2>How to set this up</h2>
          <ol class="ag-tpl-setup">
            {
              setup.map((step, i) => (
                <li>
                  <span class="ag-tpl-num">{i + 1}</span>
                  <span>
                    <span class="ag-tpl-setup__title">{step.title}</span>
                    <span class="ag-tpl-setup__text">{step.text}</span>
                  </span>
                </li>
              ))
            }
          </ol>
        </section>
      </div>

      <aside class="ag-tpl-side">
        <div class="ag-tpl-side__group">
          <h2 class="ag-tpl-side__label">What it needs</h2>
          <ul class="ag-tpl-reqs">
            {
              requirements.map((req) => (
                <li>
                  {req.app ? (
                    <AppMark app={req.app} />
                  ) : (
                    <span class="ag-appmark" aria-hidden="true">
                      <img class="th-dark-only" src="/logos/Agenta-symbol-dark-accent.svg" alt="" width="15" />
                      <img class="th-light-only" src="/logos/Agenta-symbol-light.svg" alt="" width="15" />
                    </span>
                  )}
                  <span class="ag-tpl-reqs__label">{req.label}</span>
                  {req.note && <span class="ag-tpl-reqs__note">{req.note}</span>}
                </li>
              ))
            }
          </ul>
        </div>
        {
          apps.length > 0 && (
            <div class="ag-tpl-side__group">
              <h2 class="ag-tpl-side__label">Apps</h2>
              <div class="ag-tpl-apps">
                {apps.map((app) => <AppMark app={app} />)}
              </div>
            </div>
          )
        }
        <div class="ag-tpl-side__group">
          <h2 class="ag-tpl-side__label">Created by</h2>
          <a class="ag-tpl-author" href={authorPath(template.author.id)}>
            {
              isAgenta ? (
                <>
                  <img class="th-dark-only" src="/logos/Agenta-symbol-dark-accent.svg" alt="" width="16" />
                  <img class="th-light-only" src="/logos/Agenta-symbol-light.svg" alt="" width="16" />
                </>
              ) : (
                <span class="ag-tpl-author__initials" aria-hidden="true">
                  {initialsOf(template.author.name)}
                </span>
              )
            }
            <span>{template.author.name}</span>
          </a>
          <span class="ag-tpl-side__meta">Version {template.version}</span>
        </div>
      </aside>
    </div>
  </Section>

  <CtaBand
    title={ctaHeadlineOf(template)}
    body=""
    primaryLabel={USE_IT_FOR_FREE_LABEL}
    primaryHref={cta}
    secondaryLabel=""
  />

  {
    related.length > 0 && (
      <Section class="ag-tpl-related" data-screen-label="Related">
        <h2 class="ag-tpl-related__title">Related templates</h2>
        <div class="ag-tpl-related__grid">
          {related.map((other) => (
            <a class="ag-tpl-related__card" href={templatePath(other.key)}>
              <span class="ag-tpl-related__name">{other.name}</span>
              {other.trigger && <span class="ag-tpl-related__trigger">{other.trigger}</span>}
            </a>
          ))}
        </div>
      </Section>
    )
  }

  <style is:global>
    .ag-tpl-hero {
      background: var(--th-bg-1);
      padding: 44px 56px 64px;
    }
    .ag-tpl-crumb {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 32px;
      font: var(--text-caption);
      color: var(--th-text-mut);
    }
    .ag-tpl-crumb a {
      color: inherit;
      text-decoration: none;
    }
    .ag-tpl-crumb a:hover {
      color: var(--th-text-hi);
    }
    .ag-tpl-crumb [aria-current] {
      color: var(--th-text-hi);
    }
    .ag-tpl-hero__grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 56px;
      align-items: center;
    }
    .ag-tpl-hero__grid--split {
      grid-template-columns: 360px minmax(0, 1fr);
    }
    .ag-tpl-hero__copy {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
      min-width: 0;
      max-width: 680px;
    }
    .ag-tpl-hero__title {
      margin: 0;
      font: var(--text-display-lg);
      color: var(--th-text-hi);
      text-wrap: pretty;
    }
    .ag-tpl-hero__summary {
      margin: 0;
      font: var(--text-body-md);
      color: var(--th-text-body);
      text-wrap: pretty;
    }
    .ag-tpl-hero__actions {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }
    .ag-tpl-hero__actions .ag-btn {
      height: 40px;
      padding: 0 18px;
    }
    .ag-tpl-apps {
      display: flex;
      gap: 7px;
      flex-wrap: wrap;
    }

    .ag-tpl-media {
      margin: 0;
      border-radius: 12px;
      overflow: hidden;
      background: var(--th-bg-2);
      box-shadow: 0 0 0 1px var(--th-border-subtle);
    }
    .ag-tpl-media img,
    .ag-tpl-media video,
    .ag-tpl-media iframe {
      display: block;
      width: 100%;
      border: 0;
    }
    .ag-tpl-media img,
    .ag-tpl-media iframe,
    .ag-tpl-media video {
      aspect-ratio: 16 / 9;
      object-fit: cover;
      height: auto;
    }
    .ag-tpl-media figcaption {
      padding: 10px 14px;
      font: var(--text-caption);
      color: var(--th-text-mut);
    }
    .ag-tpl-media--inline {
      margin-top: 8px;
    }

    /* Tinted panel holding the example, as in the handoff's no-video hero. */
    .ag-tpl-panel {
      border-radius: 12px;
      background: var(--th-tint);
      padding: 32px;
      box-sizing: border-box;
    }
    [data-theme="dark"] .ag-tpl-panel {
      background: var(--th-bg-2);
    }
    .ag-tpl-body {
      --tpl-body-bg: var(--th-bg-1);
      background: var(--tpl-body-bg);
      padding: 64px 56px 88px;
    }
    [data-theme="dark"] .ag-tpl-body {
      --tpl-body-bg: var(--th-bg-0);
    }
    .ag-tpl-body__grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 300px;
      gap: 72px;
      align-items: start;
    }
    .ag-tpl-main {
      display: flex;
      flex-direction: column;
      gap: 48px;
      max-width: 660px;
      min-width: 0;
    }
    .ag-tpl-block {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
    .ag-tpl-block h2 {
      margin: 0;
      font: 300 26px/1.2 var(--font-display);
      color: var(--th-text-hi);
    }
    .ag-tpl-block > p {
      margin: 0;
      font: var(--text-body-md);
      color: var(--th-text-body);
      text-wrap: pretty;
    }
    .ag-tpl-num {
      font-family: var(--font-bitmap);
      color: var(--tpl-num);
      --tpl-num: var(--ink-900);
    }
    [data-theme="dark"] .ag-tpl-num {
      --tpl-num: var(--yellow-400);
    }
    .ag-tpl-steps {
      margin: 0;
      padding: 0;
      list-style: none;
      display: grid;
      gap: 10px;
    }
    .ag-tpl-steps li {
      display: flex;
      gap: 12px;
      font: var(--text-body-md);
      color: var(--th-text-body);
    }
    .ag-tpl-setup {
      margin: 0;
      padding: 0;
      list-style: none;
      display: grid;
      gap: 12px;
    }
    .ag-tpl-setup li {
      display: flex;
      gap: 14px;
      padding: 16px 18px;
      border-radius: 10px;
      background: var(--th-ctl-bg);
      box-shadow: inset 0 0 0 1px var(--th-ctl-ring);
    }
    .ag-tpl-setup .ag-tpl-num {
      font-size: 16px;
      line-height: 1.3;
    }
    .ag-tpl-setup li > span:last-child {
      display: flex;
      flex-direction: column;
      gap: 3px;
    }
    .ag-tpl-setup__title {
      font: var(--text-label);
      color: var(--th-text-hi);
    }
    .ag-tpl-setup__text {
      font: var(--text-body-sm);
      color: var(--th-text-body);
    }

    .ag-tpl-side {
      position: sticky;
      top: 24px;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
      min-width: 0;
    }
    .ag-tpl-side__group {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .ag-tpl-side__label {
      margin: 0;
      font: var(--text-caption);
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--th-text-dim);
    }
    .ag-tpl-side__meta {
      font: var(--text-caption);
      color: var(--th-text-mut);
    }
    .ag-tpl-reqs {
      margin: 0;
      padding: 0;
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .ag-tpl-reqs li {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 6px 12px 6px 6px;
      border-radius: 8px;
      background: var(--th-ctl-bg);
      box-shadow: inset 0 0 0 1px var(--th-ctl-ring);
      font: var(--text-label);
      color: var(--th-text-hi);
    }
    .ag-tpl-reqs .ag-appmark {
      width: 28px;
      height: 28px;
      border-radius: 7px;
      box-shadow: none;
      background: transparent;
    }
    .ag-tpl-reqs__note {
      margin-left: auto;
      font: var(--text-caption);
      color: var(--th-text-mut);
    }
    .ag-tpl-author {
      display: flex;
      align-items: center;
      gap: 9px;
      width: fit-content;
      font: var(--text-label);
      color: var(--th-text-hi);
      text-decoration: none;
    }
    .ag-tpl-author:hover span:last-child {
      text-decoration: underline;
      text-decoration-color: var(--th-accent-underline);
    }
    .ag-tpl-author__initials {
      width: 20px;
      height: 20px;
      border-radius: 50%;
      background: var(--th-ctl-bg);
      box-shadow: inset 0 0 0 1px var(--th-ctl-ring);
      display: flex;
      align-items: center;
      justify-content: center;
      font: 600 10px/1 var(--font-sans);
    }

    .ag-tpl-related {
      background: var(--th-bg-1);
      padding: 64px 56px 80px;
    }
    .ag-tpl-related__title {
      margin: 0 0 24px;
      font: 300 26px/1.2 var(--font-display);
      color: var(--th-text-hi);
    }
    .ag-tpl-related__grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
    }
    .ag-tpl-related__card {
      display: flex;
      flex-direction: column;
      gap: 10px;
      padding: 22px 24px;
      border-radius: 12px;
      background: var(--th-ctl-bg);
      box-shadow: inset 0 0 0 1px var(--th-ctl-ring);
      text-decoration: none;
    }
    .ag-tpl-related__card:hover {
      background: var(--th-hover);
    }
    .ag-tpl-related__name {
      font: var(--text-title);
      color: var(--th-text-hi);
    }
    .ag-tpl-related__trigger {
      font: var(--text-caption);
      color: var(--th-text-mut);
    }

    @media (max-width: 1199px) {
      .ag-tpl-hero {
        padding: 32px 32px 48px;
      }
      .ag-tpl-crumb {
        margin-bottom: 24px;
      }
      .ag-tpl-hero__grid,
      .ag-tpl-hero__grid--split {
        grid-template-columns: minmax(0, 1fr);
        gap: 36px;
      }
      .ag-tpl-panel {
        padding: 28px;
      }
      .ag-tpl-body {
        padding: 48px 32px 64px;
      }
      .ag-tpl-body__grid {
        grid-template-columns: minmax(0, 1fr);
        gap: 48px;
      }
      .ag-tpl-main {
        max-width: none;
      }
      /* The sidebar moves above the body as a two-column grid. */
      .ag-tpl-side {
        position: static;
        order: -1;
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      .ag-tpl-related {
        padding: 48px 32px 64px;
      }
    }
    @media (max-width: 767px) {
      .ag-tpl-hero {
        padding: 24px 20px 36px;
      }
      .ag-tpl-crumb {
        margin-bottom: 20px;
      }
      .ag-tpl-hero__grid,
      .ag-tpl-hero__grid--split {
        gap: 28px;
      }
      .ag-tpl-hero__title {
        font: 300 36px/40px var(--font-display);
      }
      .ag-tpl-panel {
        padding: 16px;
      }
      .ag-tpl-body {
        padding: 36px 20px 48px;
      }
      .ag-tpl-body__grid {
        gap: 36px;
      }
      .ag-tpl-side {
        grid-template-columns: minmax(0, 1fr);
      }
      .ag-tpl-related {
        padding: 36px 20px 48px;
      }
      .ag-tpl-related__grid {
        grid-template-columns: minmax(0, 1fr);
      }
    }
  </style>
</Site>
