---
import Section from "../../components/Section.astro";
import type { GetStaticPaths } from "astro";
import Site from "../../layouts/Site.astro";
import TemplateCard from "../../components/TemplateCard.astro";
import { socialIcon } from "../../lib/blog";
import { authors as templateAuthors, templatesByAuthor } from "../../lib/templates";
import {
  MARKETPLACE_NAME,
  MARKETPLACE_PATH,
  authorProfiles,
} from "../../lib/marketplace";

// Agent Marketplace creator pages live at /creators/<id>, one per template
// author in the catalog. Blog authors keep their own /authors/<slug> pages.
export const getStaticPaths = (() =>
  authorProfiles(templateAuthors).map((profile) => ({
    params: { id: profile.id },
    props: { profile, templates: templatesByAuthor(profile.id) },
  }))) satisfies GetStaticPaths;

const { profile, templates } = Astro.props;
const { name, avatar, bio, initials, links } = profile;
const title = `${name} — ${MARKETPLACE_NAME}`;
const description = bio ?? `${name} — agent templates on the ${MARKETPLACE_NAME}.`;
---

<Site title={title} description={description}>
  <!-- Author hero -->
  <Section tone="flat"
    class="ag-pad"
    style="background:var(--au-sec-1);padding:64px 24px 48px;"
  >
    <div
      style="max-width:760px;margin:0 auto;display:flex;flex-direction:column;align-items:center;text-align:center;gap:20px;"
    >
      <a
        href={MARKETPLACE_PATH}
        style="align-self:flex-start;display:inline-flex;align-items:center;gap:7px;font:var(--text-label);color:var(--au-quiet);text-decoration:none;"
      >
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none"
          ><path
            d="M8.5 3.5 5 7l3.5 3.5"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"></path></svg
        >{MARKETPLACE_NAME}
      </a>
      {
        avatar ? (
          <img
            src={avatar}
            alt={name}
            width="128"
            height="128"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            style="width:128px;height:128px;border-radius:50%;object-fit:cover;box-shadow:var(--au-hero-avatar);"
          />
        ) : (
          <span
            role="img"
            aria-label={name}
            style="width:128px;height:128px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;font:300 44px/1 var(--font-display);color:var(--th-text-hi);background:var(--au-tile-bg);box-shadow:var(--au-hero-avatar);"
          >
            {initials}
          </span>
        )
      }
      <h1
        class="ag-h1"
        style="margin:0;font:300 52px/1.06 var(--font-display);color:var(--th-text-hi);"
      >
        {name}
      </h1>
      {
        links.length > 0 && (
          <div style="display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:10px;margin-top:4px;">
            {links.map((link) =>
              link.platform ? (
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener"
                  aria-label={link.label}
                  style="width:38px;height:38px;border-radius:9px;background:var(--au-tile-bg);box-shadow:var(--au-tile-ring);display:inline-flex;align-items:center;justify-content:center;"
                >
                  <img
                    src={socialIcon(link.platform)}
                    alt=""
                    style="width:18px;height:18px;filter:var(--au-icon-filter);"
                  />
                </a>
              ) : (
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener"
                  style="height:38px;padding:0 14px;border-radius:9px;background:var(--au-tile-bg);box-shadow:var(--au-tile-ring);display:inline-flex;align-items:center;font:var(--text-label);color:var(--th-text-hi);text-decoration:none;"
                >
                  {link.label}
                </a>
              ),
            )}
          </div>
        )
      }
    </div>
  </Section>

  <!-- Bio -->
  {
    bio && (
      <Section tone="flat"
        class="ag-prose ag-pad"
        style="background:var(--au-sec-0);padding:48px 24px;"
      >
        <div style="max-width:720px;margin:0 auto;">
          <p style="margin:0;font:400 19px/1.7 var(--font-sans);color:var(--au-bio);">
            {bio}
          </p>
        </div>
      </Section>
    )
  }

  <!-- Templates from the author (Agent Marketplace) -->
  {
    templates.length > 0 && (
      <Section tone="flat"
        class="ag-pad"
        style="background:var(--au-sec-0);padding:24px 64px 88px;"
        id="templates"
      >
        <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:32px;flex-wrap:wrap;">
          <div style="display:flex;flex-direction:column;gap:8px;">
            <h2 class="ag-dlg" style="margin:0;font:var(--text-display-lg);color:var(--th-text-hi);">
              Templates from the author
            </h2>
            <p style="margin:0;font:var(--text-body-sm);color:var(--au-sub);">
              {templates.length} {templates.length === 1 ? "template" : "templates"} on the {MARKETPLACE_NAME}
            </p>
          </div>
          <a href={MARKETPLACE_PATH} class="ag-btn ag-btn--outline">
            View all templates
          </a>
        </div>
        <div class="ag-tplgrid ag-tplgrid--boxed">
          {templates.map((template) => (
            <TemplateCard template={template} />
          ))}
        </div>
      </Section>
    )
  }

  <style is:global>
    /* Author-page theme vars. The mockups don't cover authors pages; light
       mirrors the blog-post author-bio treatment (all-white page, ink text
       scale, white social tiles with paper-200 rings). [data-theme="dark"]
       restores the exact literals the page previously hard-coded, so dark
       stays pixel-identical. */
    :root {
      --au-sec-1: var(--paper-0); /* hero band            */
      --au-sec-0: var(--paper-0); /* bio + posts bands    */
      --au-quiet: var(--ink-600); /* "All blogs" back link */
      --au-hero-avatar:
        inset 0 0 0 1px var(--paper-150), 0 8px 32px rgba(36, 36, 36, 0.12);
      --au-role: var(--ink-600);
      --au-tile-bg: #ffffff;
      --au-tile-ring: 0 0 0 1px var(--paper-200);
      /* Icons are black source SVGs; ~ink-600 grey in light. */
      --au-icon-filter: invert(0.4);
      --au-bio: var(--ink-600);
      --au-sub: var(--ink-600);
      --au-empty: var(--ink-500);
    }
    [data-theme="dark"] {
      --au-sec-1: #0e0d0f;
      --au-sec-0: #0a0a0b;
      --au-quiet: rgba(255, 255, 255, 0.55);
      --au-hero-avatar:
        inset 0 0 0 1px rgba(255, 255, 255, 0.12), 0 8px 32px rgba(0, 0, 0, 0.4);
      --au-role: var(--yellow-400);
      --au-tile-bg: rgba(255, 255, 255, 0.05);
      --au-tile-ring: inset 0 0 0 1px rgba(255, 255, 255, 0.12);
      --au-icon-filter: invert(1) brightness(0.85);
      --au-bio: rgba(255, 255, 255, 0.74);
      --au-sub: rgba(255, 255, 255, 0.55);
      --au-empty: rgba(255, 255, 255, 0.5);
    }
  </style>
</Site>
