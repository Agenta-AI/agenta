# syntax=docker/dockerfile:1.20
FROM node:24-slim

ENV NEXT_TELEMETRY_DISABLED=1 \
    TURBO_TELEMETRY_DISABLED=1 \
    PNPM_HOME="/pnpm" \
    PATH="/pnpm:$PATH" \
    PNPM_CONFIG_FETCH_TIMEOUT=3600000 \
    PNPM_CONFIG_FETCH_RETRY_MINTIMEOUT=60000 \
    PNPM_CONFIG_FETCH_RETRY_MAXTIMEOUT=600000 \
    PNPM_CONFIG_FETCH_RETRIES=10 \
    PNPM_CONFIG_FETCH_MIN_SPEED_KI_BPS=0 \
    PNPM_CONFIG_FETCH_WARN_TIMEOUT_MS=600000

WORKDIR /app

RUN npm install -g corepack@0.31.0 && \
    corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json .npmrc* ./
COPY patches/ ./patches/
COPY ./entrypoint.sh /app/entrypoint.sh

RUN PNPM_VERSION=$(node -p "require('./package.json').packageManager.split('@')[1]") && \
    corepack prepare "pnpm@${PNPM_VERSION}" --activate

# Every workspace package manifest, like Dockerfile.gh: a hand-kept list drifts
# behind the packages mobile links.
COPY mobile/package.json ./mobile/package.json
COPY --parents packages/*/package.json ./

# `agenta-api-client` runs `tsc` as a `prepare` lifecycle script during install,
# so its full source must be present before `pnpm install` runs.
COPY packages/agenta-api-client/ ./packages/agenta-api-client/

COPY packages/tsconfig.base.json packages/css-modules.d.ts ./packages/

RUN groupadd --gid 10001 agenta && \
    useradd --uid 10001 --gid 10001 --shell /bin/false --create-home agenta && \
    mkdir -p /app/.turbo /app/mobile/.next/cache && \
    chown -R agenta:agenta /app

USER 10001

RUN --mount=type=cache,id=pnpm-mobile-dev,target=/pnpm/store,uid=10001,gid=10001 \
    pnpm fetch --frozen-lockfile

RUN --mount=type=cache,id=pnpm-mobile-dev,target=/pnpm/store,uid=10001,gid=10001 \
    pnpm install --frozen-lockfile --offline

COPY --chown=agenta:agenta tsconfig.json ./

# Compose bind-mounts packages/, mobile/src and mobile/public over these copies;
# the copies make the image start on its own too.
COPY --chown=agenta:agenta packages/ ./packages/
COPY --chown=agenta:agenta mobile/src ./mobile/src
COPY --chown=agenta:agenta mobile/public ./mobile/public
COPY --chown=agenta:agenta mobile/tsconfig.json mobile/next-env.d.ts mobile/next.config.ts mobile/postcss.config.mjs mobile/components.json ./mobile/

ENTRYPOINT ["./entrypoint.sh"]
CMD ["pnpm", "dev-mobile"]
EXPOSE 3000
