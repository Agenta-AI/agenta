{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": [
                "$TURBO_DEFAULT$",
                "!**/*.md",
                "!**/*.test.ts",
                "!**/*.test.tsx",
                "!**/*.spec.ts",
                "!**/*.spec.tsx"
            ],
            "outputs": [".next/**", "!.next/cache/**"],
            "env": ["NODE_ENV", "NEXT_PUBLIC_*"]
        },
        "dev": {
            "cache": false,
            "persistent": true,
            "passThroughEnv": ["AGENTA_API_URL", "AGENTA_API_INTERNAL_URL", "AGENTA_WEB_URL"]
        },
        "lint": {
            "dependsOn": ["^lint"],
            "inputs": [
                "$TURBO_DEFAULT$",
                "**/*.ts",
                "**/*.tsx",
                "**/*.js",
                "**/*.jsx",
                ".eslintrc*",
                "eslint.config.*"
            ],
            "outputs": []
        },
        "lint:fix": {
            "dependsOn": ["^lint:fix"],
            "cache": false
        },
        "types:check": {
            "dependsOn": ["^types:check"],
            "inputs": ["$TURBO_DEFAULT$", "**/*.ts", "**/*.tsx", "tsconfig.json"],
            "outputs": []
        },
        "@agenta/shared#build": {
            "inputs": ["src/**", "tsconfig.json", "../tsconfig.base.json", "../css-modules.d.ts"],
            "outputs": [".tsbuildinfo"]
        },
        "@agenta/ui#build": {
            "inputs": ["src/**", "tsconfig.json", "../tsconfig.base.json", "../css-modules.d.ts"],
            "outputs": [".tsbuildinfo"]
        },
        "@agenta/entities#build": {
            "dependsOn": ["@agenta/shared#build", "@agenta/ui#build"],
            "inputs": ["src/**", "tsconfig.json", "../tsconfig.base.json", "../css-modules.d.ts"],
            "outputs": [".tsbuildinfo"]
        },
        "@agenta/entity-ui#build": {
            "dependsOn": ["@agenta/shared#build", "@agenta/ui#build", "@agenta/entities#build"],
            "inputs": ["src/**", "tsconfig.json", "../tsconfig.base.json", "../css-modules.d.ts"],
            "outputs": [".tsbuildinfo"]
        },
        "@agenta/playground#build": {
            "dependsOn": ["@agenta/shared#build", "@agenta/entities#build"],
            "inputs": ["src/**", "tsconfig.json", "../tsconfig.base.json", "../css-modules.d.ts"],
            "outputs": [".tsbuildinfo"]
        },
        "@agenta/playground-ui#build": {
            "dependsOn": [
                "@agenta/shared#build",
                "@agenta/ui#build",
                "@agenta/entities#build",
                "@agenta/entity-ui#build",
                "@agenta/playground#build"
            ],
            "inputs": ["src/**", "tsconfig.json", "../tsconfig.base.json", "../css-modules.d.ts"],
            "outputs": [".tsbuildinfo"]
        },
        "@agenta/chat#build": {
            "dependsOn": [
                "@agenta/shared#build",
                "@agenta/entities#build",
                "@agenta/playground#build"
            ],
            "inputs": ["src/**", "tsconfig.json", "../tsconfig.base.json", "../css-modules.d.ts"],
            "outputs": [".tsbuildinfo"]
        },
        "@agenta/sessions#build": {
            "dependsOn": ["@agenta/shared#build", "@agenta/entities#build"],
            "inputs": ["src/**", "tsconfig.json", "../tsconfig.base.json", "../css-modules.d.ts"],
            "outputs": [".tsbuildinfo"]
        },
        "@agenta/automation-ui#build": {
            "dependsOn": [
                "@agenta/shared#build",
                "@agenta/ui#build",
                "@agenta/entities#build",
                "@agenta/entity-ui#build",
                "@agenta/sessions-ui#build"
            ],
            "inputs": ["src/**", "tsconfig.json", "../tsconfig.base.json", "../css-modules.d.ts"],
            "outputs": [".tsbuildinfo"]
        },
        "@agenta/sessions-ui#build": {
            "dependsOn": [
                "@agenta/shared#build",
                "@agenta/ui#build",
                "@agenta/entities#build",
                "@agenta/sessions#build"
            ],
            "inputs": ["src/**", "tsconfig.json", "../tsconfig.base.json", "../css-modules.d.ts"],
            "outputs": [".tsbuildinfo"]
        },
        "@agenta/mobile#build": {
            "dependsOn": ["@agenta/shared#build", "@agenta/entities#build", "@agenta/chat#build"],
            "inputs": ["$TURBO_DEFAULT$", "!tests/**", "!**/*.md"],
            "outputs": [".next/**", "!.next/cache/**"],
            "env": ["NODE_ENV", "NEXT_PUBLIC_*"]
        },
        "@agenta/mobile#lint": {
            "inputs": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "eslint.config.*"],
            "outputs": []
        },
        "@agenta/mobile#types:check": {
            "dependsOn": ["^types:check"],
            "inputs": ["src/**", "next.config.ts", "tsconfig.json"],
            "outputs": []
        },
        "@agenta/shared#lint": {
            "inputs": ["src/**/*.ts", "src/**/*.tsx"],
            "outputs": []
        },
        "@agenta/ui#lint": {
            "inputs": ["src/**/*.ts", "src/**/*.tsx"],
            "outputs": []
        },
        "@agenta/entities#lint": {
            "inputs": ["src/**/*.ts", "src/**/*.tsx"],
            "outputs": []
        },
        "@agenta/entity-ui#lint": {
            "inputs": ["src/**/*.ts", "src/**/*.tsx"],
            "outputs": []
        },
        "@agenta/playground#lint": {
            "inputs": ["src/**/*.ts", "src/**/*.tsx"],
            "outputs": []
        },
        "@agenta/playground-ui#lint": {
            "inputs": ["src/**/*.ts", "src/**/*.tsx"],
            "outputs": []
        },
        "@agenta/chat#lint": {
            "inputs": ["src/**/*.ts", "src/**/*.tsx"],
            "outputs": []
        },
        "@agenta/sessions#lint": {
            "inputs": ["src/**/*.ts", "src/**/*.tsx", "eslint.config.*"],
            "outputs": []
        },
        "@agenta/automation-ui#lint": {
            "inputs": ["src/**/*.ts", "src/**/*.tsx", "eslint.config.*"],
            "outputs": []
        },
        "@agenta/sessions-ui#lint": {
            "inputs": ["src/**/*.ts", "src/**/*.tsx", "eslint.config.*"],
            "outputs": []
        },
        "@agenta/shared#types:check": {
            "inputs": ["src/**", "tsconfig.json", "../tsconfig.base.json", "../css-modules.d.ts"],
            "outputs": []
        },
        "@agenta/ui#types:check": {
            "inputs": ["src/**", "tsconfig.json", "../tsconfig.base.json", "../css-modules.d.ts"],
            "outputs": []
        },
        "@agenta/entities#types:check": {
            "dependsOn": ["@agenta/shared#types:check", "@agenta/ui#types:check"],
            "inputs": ["src/**", "tsconfig.json", "../tsconfig.base.json", "../css-modules.d.ts"],
            "outputs": []
        },
        "@agenta/entity-ui#types:check": {
            "dependsOn": [
                "@agenta/shared#types:check",
                "@agenta/ui#types:check",
                "@agenta/entities#types:check"
            ],
            "inputs": ["src/**", "tsconfig.json", "../tsconfig.base.json", "../css-modules.d.ts"],
            "outputs": []
        },
        "@agenta/playground#types:check": {
            "dependsOn": ["@agenta/shared#types:check", "@agenta/entities#types:check"],
            "inputs": ["src/**", "tsconfig.json", "../tsconfig.base.json", "../css-modules.d.ts"],
            "outputs": []
        },
        "@agenta/playground-ui#types:check": {
            "dependsOn": [
                "@agenta/shared#types:check",
                "@agenta/ui#types:check",
                "@agenta/entities#types:check",
                "@agenta/entity-ui#types:check",
                "@agenta/playground#types:check"
            ],
            "inputs": ["src/**", "tsconfig.json", "../tsconfig.base.json", "../css-modules.d.ts"],
            "outputs": []
        },
        "@agenta/chat#types:check": {
            "dependsOn": [
                "@agenta/shared#types:check",
                "@agenta/entities#types:check",
                "@agenta/playground#types:check"
            ],
            "inputs": ["src/**", "tsconfig.json", "../tsconfig.base.json", "../css-modules.d.ts"],
            "outputs": []
        },
        "@agenta/sessions#types:check": {
            "dependsOn": ["@agenta/shared#types:check", "@agenta/entities#types:check"],
            "inputs": ["src/**", "tsconfig.json", "../tsconfig.base.json", "../css-modules.d.ts"],
            "outputs": []
        },
        "@agenta/automation-ui#types:check": {
            "dependsOn": [
                "@agenta/shared#types:check",
                "@agenta/ui#types:check",
                "@agenta/entities#types:check",
                "@agenta/entity-ui#types:check",
                "@agenta/sessions-ui#types:check"
            ],
            "inputs": ["src/**", "tsconfig.json", "../tsconfig.base.json", "../css-modules.d.ts"],
            "outputs": []
        },
        "@agenta/sessions-ui#types:check": {
            "dependsOn": [
                "@agenta/shared#types:check",
                "@agenta/ui#types:check",
                "@agenta/entities#types:check",
                "@agenta/sessions#types:check"
            ],
            "inputs": ["src/**", "tsconfig.json", "../tsconfig.base.json", "../css-modules.d.ts"],
            "outputs": []
        }
    },
    "globalDependencies": ["tsconfig.json", "package.json", "pnpm-lock.yaml"],
    "globalEnv": ["CI", "DISABLE_PRETTIER", "NODE_ENV"]
}
