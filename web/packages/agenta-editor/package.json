{
    "name": "@agenta/editor",
    "version": "0.75.0",
    "private": true,
    "description": "The Lexical editors (rich text, code, chat input, chat messages, quote selection) and the drill-in field views built on them.",
    "sideEffects": [
        "*.css",
        "**/*.css"
    ],
    "scripts": {
        "build": "pnpm run types:check",
        "types:check": "tsc --noEmit",
        "lint": "eslint --config ../eslint.config.mjs src/ --max-warnings 0",
        "lint:fix": "eslint --config ../eslint.config.mjs src/ --max-warnings 0 --fix",
        "test": "pnpm run test:tsc && pnpm run test:unit",
        "test:tsc": "pnpm run types:check && pnpm run lint",
        "test:unit": "vitest run",
        "test:watch": "vitest"
    },
    "exports": {
        "./chat-message": "./src/chat-message/index.ts",
        "./code-editor-styles.css": "./src/styles/code-editor-styles.css",
        "./diff": "./src/editor/utils/diffUtils.ts",
        "./drill-in": "./src/drill-in/index.ts",
        "./editor": "./src/editor/index.ts",
        "./editor-theme.css": "./src/styles/editor-theme.css",
        "./quote-selection": "./src/quote-selection/index.ts",
        "./rich-chat-input": "./src/rich-chat-input/index.ts",
        "./shared-editor": "./src/shared-editor/index.ts"
    },
    "peerDependencies": {
        "@lexical/code": ">=0.38.0",
        "@lexical/code-shiki": ">=0.38.0",
        "@lexical/hashtag": ">=0.38.0",
        "@lexical/history": ">=0.38.0",
        "@lexical/html": ">=0.38.0",
        "@lexical/link": ">=0.38.0",
        "@lexical/list": ">=0.38.0",
        "@lexical/mark": ">=0.38.0",
        "@lexical/markdown": ">=0.38.0",
        "@lexical/overflow": ">=0.38.0",
        "@lexical/react": ">=0.38.0",
        "@lexical/rich-text": ">=0.38.0",
        "@lexical/selection": ">=0.38.0",
        "@lexical/table": ">=0.38.0",
        "@lexical/utils": ">=0.38.0",
        "jotai": ">=2.9.0",
        "js-yaml": ">=4.0.0",
        "lexical": ">=0.38.0",
        "react": ">=18.0.0",
        "react-dom": ">=18.0.0"
    },
    "dependencies": {
        "@agenta/i18n": "workspace:../agenta-i18n",
        "@agenta/shared": "workspace:../agenta-shared",
        "@agenta/ui": "workspace:../agenta-ui",
        "@floating-ui/react": "^0.27.13",
        "@lexical/code": "^0.46.0",
        "@lexical/code-shiki": "^0.46.0",
        "@lexical/hashtag": "^0.46.0",
        "@lexical/history": "^0.46.0",
        "@lexical/html": "^0.46.0",
        "@lexical/link": "^0.46.0",
        "@lexical/list": "^0.46.0",
        "@lexical/mark": "^0.46.0",
        "@lexical/markdown": "^0.46.0",
        "@lexical/overflow": "^0.46.0",
        "@lexical/react": "^0.46.0",
        "@lexical/rich-text": "^0.46.0",
        "@lexical/selection": "^0.46.0",
        "@lexical/table": "^0.46.0",
        "@lexical/utils": "^0.46.0",
        "@phosphor-icons/react": "^2.1.10",
        "clsx": "^2.1.1",
        "dompurify": "^3.4.17",
        "fast-deep-equal": "^3.1.3",
        "jotai": "^2.16.1",
        "jotai-family": "^1.0.1",
        "js-yaml": "^4.3.1",
        "json5": "^2.2.3",
        "lexical": "^0.46.0",
        "marked": "^17.0.4",
        "prismjs": "^1.30.0",
        "uuid": "^11.1.1"
    },
    "devDependencies": {
        "@testing-library/dom": "^10.4.0",
        "@testing-library/react": "^16.3.2",
        "@types/js-yaml": "^4.0.9",
        "@types/node": "^20.19.20",
        "@types/prismjs": "^1.26.5",
        "@types/react": "^19.0.10",
        "@types/react-dom": "^19.0.4",
        "@vitejs/plugin-react-swc": "^4.3.2",
        "@vitest/coverage-v8": "^4.1.11",
        "jsdom": "^26.1.0",
        "typescript": "^5.9.3",
        "vitest": "^4.1.11"
    }
}
