{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "baseUrl": ".",
        "tsBuildInfoFile": ".tsbuildinfo",
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true
    },
    "include": ["src/**/*.ts", "src/**/*.tsx", "scripts/**/*.ts", "locales/**/*.json"],
    "exclude": ["node_modules", "dist"]
}
