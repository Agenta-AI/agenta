{
  "color": {
    "background": {
      "$type": "color",
      "$value": "#fefdfc",
      "$description": "Main content area. The ground for every text color.",
      "$extensions": {
        "com.agenta.modes": {
          "dark": "#0f0e0d"
        }
      }
    },
    "foreground": {
      "$type": "color",
      "$value": "#1f1e1c",
      "$description": "Primary text and icons (≥12:1). Also the tooltip fill and the inner focus ring.",
      "$extensions": {
        "com.agenta.modes": {
          "dark": "#eeecea"
        }
      }
    },
    "muted": {
      "$type": "color",
      "$value": "#f8f6f4",
      "$description": "Sidebar, the right pane and grouped blocks. Separates an area by tone, not by a border.",
      "$extensions": {
        "com.agenta.modes": {
          "dark": "#151412"
        }
      }
    },
    "muted-foreground": {
      "$type": "color",
      "$value": "#605d59",
      "$description": "Secondary text: descriptions, meta, timestamps, placeholders, inactive nav, icon buttons (≥4.5:1 on every surface).",
      "$extensions": {
        "com.agenta.modes": {
          "dark": "#9a9893"
        }
      }
    },
    "secondary": {
      "$type": "color",
      "$value": "#1f1e1c0a",
      "$description": "Fill of quiet controls: secondary button, segmented control, chips, Marks, user chat turns. Ink at 4%, so it stays one step darker than any surface it sits on, hover included.",
      "$extensions": {
        "com.agenta.modes": {
          "dark": "#eeecea0a"
        }
      }
    },
    "accent": {
      "$type": "color",
      "$value": "#1f1e1c0d",
      "$description": "The one hover fill: rows, nav items, menu items and ghost controls. Ink at 5% (6% in dark), so hover is one step darker than the surface under it, and fills inside the row stay visible.",
      "$extensions": {
        "com.agenta.modes": {
          "dark": "#eeecea0f"
        }
      }
    },
    "selected": {
      "$type": "color",
      "$value": "#ebe9e6",
      "$description": "Selected row, active nav item, pressed state.",
      "$extensions": {
        "com.agenta.modes": {
          "dark": "#262422"
        }
      }
    },
    "popover": {
      "$type": "color",
      "$value": "#fefdfc",
      "$description": "Menus, popovers, dialogs, sheets, toasts. A step lighter than background in dark.",
      "$extensions": {
        "com.agenta.modes": {
          "dark": "#1c1b19"
        }
      }
    },
    "overlay": {
      "$type": "color",
      "$value": "rgba(15, 14, 13, 0.40)",
      "$description": "Dims the page behind a dialog or sheet.",
      "$extensions": {
        "com.agenta.modes": {
          "dark": "rgba(0, 0, 0, 0.60)"
        }
      }
    },
    "scrim": {
      "$type": "color",
      "$value": "rgba(0, 0, 0, 0.55)",
      "$description": "Media only: the dark film behind captions and controls on images and video.",
      "$extensions": {
        "com.agenta.modes": {
          "dark": "rgba(0, 0, 0, 0.55)"
        }
      }
    },
    "on-scrim": {
      "$type": "color",
      "$value": "#ffffff",
      "$description": "Media only: text and icons on scrim.",
      "$extensions": {
        "com.agenta.modes": {
          "dark": "#ffffff"
        }
      }
    },
    "logo-ground": {
      "$type": "color",
      "$value": "#ffffff",
      "$description": "Media only: the white tile behind a third-party brand logo.",
      "$extensions": {
        "com.agenta.modes": {
          "dark": "#ffffff"
        }
      }
    },
    "data-1": {
      "$type": "color",
      "$value": "#4f7cac",
      "$description": "Data only: first category or series.",
      "$extensions": {
        "com.agenta.modes": {
          "dark": "#7ea6d4"
        }
      }
    },
    "data-2": {
      "$type": "color",
      "$value": "#5b8f68",
      "$description": "Data only: second category or series.",
      "$extensions": {
        "com.agenta.modes": {
          "dark": "#86bd93"
        }
      }
    },
    "data-3": {
      "$type": "color",
      "$value": "#b07d36",
      "$description": "Data only: third category or series.",
      "$extensions": {
        "com.agenta.modes": {
          "dark": "#d8ad6b"
        }
      }
    },
    "data-4": {
      "$type": "color",
      "$value": "#8a64a3",
      "$description": "Data only: fourth category or series.",
      "$extensions": {
        "com.agenta.modes": {
          "dark": "#b796cc"
        }
      }
    },
    "data-5": {
      "$type": "color",
      "$value": "#b5605f",
      "$description": "Data only: fifth category or series.",
      "$extensions": {
        "com.agenta.modes": {
          "dark": "#dc9190"
        }
      }
    },
    "data-6": {
      "$type": "color",
      "$value": "#3f8a8a",
      "$description": "Data only: sixth category or series.",
      "$extensions": {
        "com.agenta.modes": {
          "dark": "#74bcbc"
        }
      }
    },
    "on-data": {
      "$type": "color",
      "$value": "#ffffff",
      "$description": "Data only: letters and glyphs on a data-* fill.",
      "$extensions": {
        "com.agenta.modes": {
          "dark": "#0f0e0d"
        }
      }
    },
    "code-keyword": {
      "$type": "color",
      "$value": "#76518f",
      "$description": "Code only: keywords and operators.",
      "$extensions": {
        "com.agenta.modes": {
          "dark": "#b796cc"
        }
      }
    },
    "code-string": {
      "$type": "color",
      "$value": "#3b6f4d",
      "$description": "Code only: strings.",
      "$extensions": {
        "com.agenta.modes": {
          "dark": "#86bd93"
        }
      }
    },
    "code-number": {
      "$type": "color",
      "$value": "#855711",
      "$description": "Code only: numbers and constants.",
      "$extensions": {
        "com.agenta.modes": {
          "dark": "#d8ad6b"
        }
      }
    },
    "code-function": {
      "$type": "color",
      "$value": "#386492",
      "$description": "Code only: function, class and tag names.",
      "$extensions": {
        "com.agenta.modes": {
          "dark": "#7ea6d4"
        }
      }
    },
    "code-property": {
      "$type": "color",
      "$value": "#2a6d6d",
      "$description": "Code only: property names and keys.",
      "$extensions": {
        "com.agenta.modes": {
          "dark": "#74bcbc"
        }
      }
    },
    "border": {
      "$type": "color",
      "$value": "#e2e0dc",
      "$description": "Card edges, inputs and outline buttons at rest.",
      "$extensions": {
        "com.agenta.modes": {
          "dark": "#2f2d2a"
        }
      }
    },
    "border-muted": {
      "$type": "color",
      "$value": "#ebe9e6",
      "$description": "Dividers inside a card or list.",
      "$extensions": {
        "com.agenta.modes": {
          "dark": "#242220"
        }
      }
    },
    "border-strong": {
      "$type": "color",
      "$value": "#797773",
      "$description": "Edges that carry meaning: checkbox, switch, radio, hovered input (≥3:1 on every surface).",
      "$extensions": {
        "com.agenta.modes": {
          "dark": "#7c7a76"
        }
      }
    },
    "primary": {
      "$type": "color",
      "$value": "#242424",
      "$description": "LOCKED. The default (primary) button. Ink in light, brand yellow in dark.",
      "$extensions": {
        "com.agenta.modes": {
          "dark": "#f2f25c"
        }
      }
    },
    "primary-hover": {
      "$type": "color",
      "$value": "#413f3f",
      "$description": "LOCKED. Primary hover.",
      "$extensions": {
        "com.agenta.modes": {
          "dark": "#e8e47e"
        }
      }
    },
    "brand": {
      "$type": "color",
      "$value": "#f2f25c",
      "$description": "LOCKED brand yellow. The one brand action, New agent on Home. Tint: brand/15.",
      "$extensions": {
        "com.agenta.modes": {
          "dark": "#d1d151"
        }
      }
    },
    "brand-hover": {
      "$type": "color",
      "$value": "#e7e712",
      "$description": "LOCKED. Brand hover.",
      "$extensions": {
        "com.agenta.modes": {
          "dark": "#dcdc6b"
        }
      }
    },
    "brand-foreground": {
      "$type": "color",
      "$value": "#242424",
      "$description": "Text on brand.",
      "$extensions": {
        "com.agenta.modes": {
          "dark": "#141414"
        }
      }
    },
    "link": {
      "$type": "color",
      "$value": "#5e5e08",
      "$description": "LOCKED. Inline links, always underlined.",
      "$extensions": {
        "com.agenta.modes": {
          "dark": "#8ccfff"
        }
      }
    },
    "ring": {
      "$type": "color",
      "$value": "#d9d92c",
      "$description": "LOCKED brand lime. Outer focus outline, always with a foreground ring inside it.",
      "$extensions": {
        "com.agenta.modes": {
          "dark": "#d9d92c"
        }
      }
    },
    "destructive": {
      "$type": "color",
      "$value": "#b6322d",
      "$description": "Errors and destructive actions. Text, icons and the confirm button; tint with destructive/10.",
      "$extensions": {
        "com.agenta.modes": {
          "dark": "#f66d62"
        }
      }
    },
    "success": {
      "$type": "color",
      "$value": "#007835",
      "$description": "Passed, done. Text and icons; tint with success/10.",
      "$extensions": {
        "com.agenta.modes": {
          "dark": "#37bb62"
        }
      }
    },
    "warning": {
      "$type": "color",
      "$value": "#965802",
      "$description": "Needs attention. Text and icons; tint with warning/10.",
      "$extensions": {
        "com.agenta.modes": {
          "dark": "#df8605"
        }
      }
    },
    "info": {
      "$type": "color",
      "$value": "#0068a5",
      "$description": "Running, informational. Text and icons; tint with info/10.",
      "$extensions": {
        "com.agenta.modes": {
          "dark": "#1fa6ff"
        }
      }
    }
  },
  "typography": {
    "text-display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "var(--font-inter, \"Inter\"), ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
        "fontSize": "28px",
        "lineHeight": "34px",
        "fontWeight": 600,
        "letterSpacing": "-0.02em"
      },
      "$description": "The Home greeting, first-run hero screens, and the title on auth and error pages. Nowhere else."
    },
    "text-heading": {
      "$type": "typography",
      "$value": {
        "fontFamily": "var(--font-inter, \"Inter\"), ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
        "fontSize": "20px",
        "lineHeight": "28px",
        "fontWeight": 600,
        "letterSpacing": "-0.015em"
      },
      "$description": "Page titles. One per page, the anchor of the alignment line."
    },
    "text-title": {
      "$type": "typography",
      "$value": {
        "fontFamily": "var(--font-inter, \"Inter\"), ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
        "fontSize": "16px",
        "lineHeight": "22px",
        "fontWeight": 600,
        "letterSpacing": "-0.01em"
      },
      "$description": "Card and dialog titles."
    },
    "text-body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "var(--font-inter, \"Inter\"), ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
        "fontSize": "14px",
        "lineHeight": "22px",
        "fontWeight": 400,
        "letterSpacing": "0"
      },
      "$description": "Chat messages, descriptions, prose. Multi-line text."
    },
    "text-label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "var(--font-inter, \"Inter\"), ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
        "fontSize": "13px",
        "lineHeight": "18px",
        "fontWeight": 500,
        "letterSpacing": "0"
      },
      "$description": "The default for controls, nav, list rows and labels. Single-line text. The kit applies it through text-btn-md and text-field-md."
    },
    "text-body-sm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "var(--font-inter, \"Inter\"), ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
        "fontSize": "13px",
        "lineHeight": "20px",
        "fontWeight": 400,
        "letterSpacing": "0"
      },
      "$description": "13px text that can wrap: field and cell values, card descriptions, short secondary prose."
    },
    "text-subtitle": {
      "$type": "typography",
      "$value": {
        "fontFamily": "var(--font-inter, \"Inter\"), ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
        "fontSize": "13px",
        "lineHeight": "18px",
        "fontWeight": 600,
        "letterSpacing": "0"
      },
      "$description": "Section and panel titles inside a page or the right pane."
    },
    "text-metric": {
      "$type": "typography",
      "$value": {
        "fontFamily": "var(--font-inter, \"Inter\"), ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
        "fontSize": "20px",
        "lineHeight": "28px",
        "fontWeight": 500,
        "letterSpacing": "0"
      },
      "$description": "A number that is the point of a tile: credits, counts, scores. With tabular-nums."
    },
    "text-meta": {
      "$type": "typography",
      "$value": {
        "fontFamily": "var(--font-inter, \"Inter\"), ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
        "fontSize": "12px",
        "lineHeight": "16px",
        "fontWeight": 450,
        "letterSpacing": "0"
      },
      "$description": "Meta lines, timestamps, secondary table cells."
    },
    "text-caption": {
      "$type": "typography",
      "$value": {
        "fontFamily": "var(--font-inter, \"Inter\"), ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
        "fontSize": "11px",
        "lineHeight": "16px",
        "fontWeight": 500,
        "letterSpacing": "0.01em"
      },
      "$description": "Badges, keyboard hints, and the letter in a 16–24px Mark."
    },
    "text-code": {
      "$type": "typography",
      "$value": {
        "fontFamily": "var(--font-jetbrains-mono, \"JetBrains Mono\"), ui-monospace, SFMono-Regular, Menlo, monospace",
        "fontSize": "13px",
        "lineHeight": "20px",
        "fontWeight": 400,
        "letterSpacing": "0"
      },
      "$description": "Code blocks, JSON, tool calls."
    },
    "text-code-sm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "var(--font-jetbrains-mono, \"JetBrains Mono\"), ui-monospace, SFMono-Regular, Menlo, monospace",
        "fontSize": "12px",
        "lineHeight": "16px",
        "fontWeight": 500,
        "letterSpacing": "0"
      },
      "$description": "Inline code, IDs, keys."
    }
  },
  "spacing": {
    "spacing-0.5": {
      "$type": "dimension",
      "$value": "2px",
      "$description": "Hairline offsets."
    },
    "spacing-1": {
      "$type": "dimension",
      "$value": "4px",
      "$description": "The tightest gap: inside badges and xs buttons, between grouped buttons, inside menus."
    },
    "spacing-1.5": {
      "$type": "dimension",
      "$value": "6px",
      "$description": "Gaps inside a control."
    },
    "spacing-2": {
      "$type": "dimension",
      "$value": "8px",
      "$description": "Gaps inside a row."
    },
    "spacing-3": {
      "$type": "dimension",
      "$value": "12px",
      "$description": "List row side padding. Gap between a label and its field group."
    },
    "spacing-4": {
      "$type": "dimension",
      "$value": "16px",
      "$description": "Page gutter on compact windows; card padding."
    },
    "spacing-5": {
      "$type": "dimension",
      "$value": "20px",
      "$description": "Dialog padding."
    },
    "spacing-6": {
      "$type": "dimension",
      "$value": "24px",
      "$description": "Gap between the title row and the body; the right pane's own margins; section gap on compact."
    },
    "spacing-8": {
      "$type": "dimension",
      "$value": "32px",
      "$description": "Top of every page; section gap on medium and expanded windows."
    },
    "spacing-10": {
      "$type": "dimension",
      "$value": "40px",
      "$description": "Space above an empty state."
    },
    "spacing-12": {
      "$type": "dimension",
      "$value": "48px",
      "$description": "Page top padding on expanded windows."
    },
    "spacing-16": {
      "$type": "dimension",
      "$value": "64px",
      "$description": "Largest layout gap."
    }
  },
  "radius": {
    "radius-xs": {
      "$type": "dimension",
      "$value": "2px",
      "$description": "Timeline nodes, skeleton bars, legend swatches and thin bars of 4–8px."
    },
    "radius-sm": {
      "$type": "dimension",
      "$value": "4px",
      "$description": "Badges, kbd, chips, menu items, checkboxes, 16 and 20px Marks."
    },
    "radius-md": {
      "$type": "dimension",
      "$value": "6px",
      "$description": "Controls, inputs, nav items, 24 and 32px Marks."
    },
    "radius-lg": {
      "$type": "dimension",
      "$value": "8px",
      "$description": "Cards, menus, popovers, banners, toasts, the 40px Mark."
    },
    "radius-xl": {
      "$type": "dimension",
      "$value": "12px",
      "$description": "Dialogs and sheets. Inner parts use radius-lg (12 − 4 padding)."
    },
    "radius-round": {
      "$type": "dimension",
      "$value": "9999px",
      "$description": "Only for things that are round by nature: status dots, typing dots, the switch track and thumb, the radio and its dot, the slider handle."
    }
  },
  "size": {
    "control-xs": {
      "$type": "dimension",
      "$value": "24px",
      "$description": "Controls inside inputs and dense toolbars."
    },
    "control-sm": {
      "$type": "dimension",
      "$value": "28px",
      "$description": "Small controls: size=\"sm\" buttons and selects, toolbar and row actions."
    },
    "control-md": {
      "$type": "dimension",
      "$value": "32px",
      "$description": "The default control height: buttons, inputs and selects."
    },
    "control-lg": {
      "$type": "dimension",
      "$value": "40px",
      "$description": "The composer and the brand action on Home."
    },
    "control-md-compact": {
      "$type": "dimension",
      "$value": "28px",
      "$description": "control-md on a compact window (below 640px): the default control steps down one size."
    },
    "control-lg-compact": {
      "$type": "dimension",
      "$value": "32px",
      "$description": "control-lg on a compact window (below 640px)."
    },
    "icon-xs": {
      "$type": "dimension",
      "$value": "10px",
      "$description": "Icons inside a 16px Mark."
    },
    "icon-sm": {
      "$type": "dimension",
      "$value": "12px",
      "$description": "Icons in badges and xs buttons, and in a 20px Mark."
    },
    "icon-md": {
      "$type": "dimension",
      "$value": "14px",
      "$description": "Icons in 28px controls, and in a 24px Mark."
    },
    "icon-lg": {
      "$type": "dimension",
      "$value": "16px",
      "$description": "Icons in menu rows, list rows, tabs and 32px controls, and in a 32px Mark."
    },
    "icon-xl": {
      "$type": "dimension",
      "$value": "20px",
      "$description": "Icons inside a 40px Mark."
    },
    "mark-xs": {
      "$type": "dimension",
      "$value": "16px",
      "$description": "Mark inside text, in nav and in menus. Radius radius-sm, icon 10."
    },
    "mark-sm": {
      "$type": "dimension",
      "$value": "20px",
      "$description": "Mark in pickers and composer chips. Radius radius-sm, icon 12."
    },
    "mark-md": {
      "$type": "dimension",
      "$value": "24px",
      "$description": "Mark in list rows (default). Radius radius-md, icon 14."
    },
    "mark-lg": {
      "$type": "dimension",
      "$value": "32px",
      "$description": "Mark in the title row, dialog headers and cards. Radius radius-md, icon 16."
    },
    "mark-xl": {
      "$type": "dimension",
      "$value": "40px",
      "$description": "Mark in empty states. Radius radius-lg, icon 20."
    },
    "header-h": {
      "$type": "dimension",
      "$value": "44px",
      "$description": "The compact header: the one bar at the top of a compact window."
    },
    "sidebar-w": {
      "$type": "dimension",
      "$value": "240px",
      "$description": "Sidebar width on medium and expanded windows."
    },
    "sidebar-w-closed": {
      "$type": "dimension",
      "$value": "48px",
      "$description": "Sidebar width when it is closed."
    },
    "page-margin": {
      "$type": "dimension",
      "$value": "80px",
      "$description": "Smallest margin on each side of the content column on medium and expanded windows. More room grows both margins equally."
    },
    "page-band": {
      "$type": "dimension",
      "$value": "148px",
      "$description": "Not used by the agreed layout, which has a title row. To be removed with the layout work."
    },
    "popover-sm": {
      "$type": "dimension",
      "$value": "240px",
      "$description": "Menus."
    },
    "popover-md": {
      "$type": "dimension",
      "$value": "320px",
      "$description": "Pickers and popovers with search."
    },
    "popover-lg": {
      "$type": "dimension",
      "$value": "400px",
      "$description": "Rich popovers."
    },
    "content-sm": {
      "$type": "dimension",
      "$value": "560px",
      "$description": "Dialogs, forms, settings."
    },
    "content-md": {
      "$type": "dimension",
      "$value": "760px",
      "$description": "Chat column, documents."
    },
    "content-lg": {
      "$type": "dimension",
      "$value": "1040px",
      "$description": "Lists and tables."
    },
    "panel-side": {
      "$type": "dimension",
      "$value": "320px",
      "$description": "The right pane: a layout slot on every page that any feature can fill (details, activity, the agent chat, a preview). One thing at a time. Its own 24px margins and alignment line."
    },
    "row-dense": {
      "$type": "dimension",
      "$value": "28px",
