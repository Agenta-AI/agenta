{
    "name": "@agenta/settings",
    "version": "0.111.0",
    "private": true,
    "sideEffects": false,
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "scripts": {
        "build": "tsc --noEmit",
        "types:check": "tsc --noEmit",
        "lint": "eslint --config ./eslint.config.mjs src/",
