        "react": ">=18.0.0"
    },
    "devDependencies": {
        "@tanstack/react-query": "5.100.9",
        "@types/node": "^20.19.20",
        "@types/react": "^19.0.10",
        "@types/react-dom": "^19.0.4",
        "@vitejs/plugin-react-swc": "^4.3.2",
        "antd": "^6.1.3",
        "jotai": "^2.15.0",
        "jsdom": "^26.1.0",
        "next": "15.5.21",
