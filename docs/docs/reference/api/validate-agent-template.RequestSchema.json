{"title":"Body","body":{"required":true,"content":{"application/json":{"schema":{"properties":{"source":{"oneOf":[{"properties":{"kind":{"type":"string","const":"internal","title":"Kind","default":"internal"},"key":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$","title":"Key"}},"additionalProperties":false,"type":"object","required":["key"],"title":"InternalTemplateSource"},{"properties":{"kind":{"type":"string","const":"upload","title":"Kind","default":"upload"},"staging_session_id":{"type":"string","maxLength":256,"minLength":1,"title":"Staging Session Id"},"attachment_id":{"type":"string","format":"uuid","title":"Attachment Id"}},"additionalProperties":false,"type":"object","required":["staging_session_id","attachment_id"],"title":"UploadTemplateSource","description":"A zip the user uploaded as a staged session attachment.\n\nAttachments are immutable once ready (the row keeps a content digest), so the\nreference itself pins the bytes."},{"properties":{"kind":{"type":"string","const":"session_file","title":"Kind","default":"session_file"},"session_id":{"type":"string","maxLength":256,"minLength":1,"title":"Session Id"},"path":{"type":"string","maxLength":1024,"minLength":1,"title":"Path"},"pin":{"anyOf":[{"properties":{"version":{"type":"string","maxLength":128,"minLength":1,"title":"Version"},"digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$","title":"Digest"}},"additionalProperties":false,"type":"object","required":["version","digest"],"title":"TemplateSourcePin"},{"type":"null"}]}},"additionalProperties":false,"type":"object","required":["session_id","path"],"title":"SessionFileTemplateSource","description":"A zip in a session's working directory, such as one an agent wrote in chat.\n\nThe file is mutable, so load requires the pin that validation returned and\nrejects bytes that no longer match it."},{"properties":{"kind":{"type":"string","const":"github","title":"Kind","default":"github"},"repo_url":{"type":"string","maxLength":256,"title":"R