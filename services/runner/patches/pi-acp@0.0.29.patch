+// Types for the embeddable ACP session module (added by the Agenta runner's pi-acp patch).
+
+/** The Pi RPC surface a session drives: a subprocess in the CLI, or an in-process adapter. */
+export interface PiProcess {
+  onEvent(handler: (event: Record<string, unknown>) => void): () => void;
+  prompt(message: string, images?: PiImage[]): Promise<void>;
+  abort(): Promise<void>;
+  sendExtensionUiResponse(response: ExtensionUiResponse): Promise<void>;
+}
+
+export type ExtensionUiResponse =
+  | { id: string; cancelled: true }
+  | { id: string; value: string }
+  | { id: string; confirmed: boolean };
+
+export interface PiImage {
+  type: "image";
+  mimeType: string;
+  data: string;
+}
+
+export type PermissionOptionKind = "allow_once" | "allow_always" | "reject_once" | "reject_always";
+
+export interface PermissionOption {
+  optionId: string;
+  name: string;
+  kind: PermissionOptionKind;
+}
+
+/** The tool call a session puts on the permission request it raises for an extension dialog. */
+export interface DialogToolCall {
+  toolCallId: string;
+  title: string;
+  kind: "other";
+  status: "pending";
+  rawInput: Record<string, unknown>;
+}
+
+export interface PermissionOutcome {
+  outcome: { outcome: "cancelled" } | { outcome: "selected"; optionId: string };
+}
+
+/** The ACP client side a session talks to. */
+export interface AcpClientConnection {
+  sessionUpdate(params: { sessionId: string; update: Record<string, unknown> }): Promise<void>;
+  requestPermission(params: {
+    sessionId: string;
+    toolCall: DialogToolCall;
+    options: PermissionOption[];
+  }): Promise<PermissionOutcome>;
+}
+
+/** One edit's content before and after, captured by the host inside the edit itself. */
+export interface EditDiff {
+  path: string;
+  oldText: string;
+  newText: string;
+}
+
+export interface PiAcpSessionOptions {
+  sessionId: string;
+  cwd: string;
+  mcpServers?: unknown[];
+  proc: PiProcess;
+  conn: AcpClientConnection;
+  fileCommands?: unknown[];
+  /** Supplies edit diffs so the session never reads files while mapping events. */
+  editDiffs?: { take(toolCallId: string): EditDiff | undefined };
+  /** Reject a failed prompt with its message and continue with queued prompts. */
+  rejectPromptFailures?: boolean;
+}
+
+export declare class PiAcpSession {
+  readonly sessionId: string;
+  constructor(opts: PiAcpSessionOptions);
+  /** Resolves with the ACP stop reason: "end_turn", "cancelled" or "error". */
+  prompt(message: string, images?: PiImage[]): Promise<string>;
+  cancel(): Promise<void>;
+  wasCancelRequested(): boolean;
+  flushEmits(): Promise<void>;
+}
+
+export declare function promptToPiMessage(blocks: unknown[]): { message: string; images: PiImage[] };
+
+export declare function replayPiMessages(
+  messages: unknown[],
+  sessionUpdate: (update: Record<string, unknown>) => Promise<void>,
+): Promise<void>;
+
+export declare function toolResultToText(result: unknown): string;
