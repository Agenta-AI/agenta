{
  "name": "agenta-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.0",
  "description": "Agenta sandbox-agent runner. Reads one /run request and drives a coding harness.",
  "runtimeAgentPins": {
    "_comment": "Harness adapters the sandbox-agent daemon installs at runtime (not npm dependencies of this package). Codex is pinned in the runner image build (docker/Dockerfile.{gh,dev}) via `install-agent codex --agent-process-version`, per decision D-005; recorded here next to the sandbox-agent pin so a version bump is discoverable. Codex is Apache-2.0 (bakeable); Claude Code is proprietary and installed at runtime by Anthropic (never pinned/baked).",
    "@agentclientprotocol/codex-acp": "1.6.2",
    "@openai/codex": "0.149.1"
  },
  "scripts": {
    "run:cli": "tsx src/cli.ts",
    "serve": "tsx src/server.ts",
    "serve:watch": "tsx watch src/server.ts",
    "build:extension": "node scripts/build-extension.mjs",
    "check:deps": "node check_deps.mjs",
    "bump:deps": "pnpm up --latest @agentclientprotocol/claude-agent-acp @anthropic-ai/sdk @daytonaio/sdk @earendil-works/pi-coding-agent @opentelemetry/api @opentelemetry/core @opentelemetry/exporter-trace-otlp-proto @opentelemetry/resources @opentelemetry/sdk-trace-base @opentelemetry/sdk-trace-node @opentelemetry/semantic-conventions undici",
    "sync:deps": "pnpm up",
    "login": "pi",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run --project unit --reporter=default --reporter=junit --outputFile.junit=./tests/results/junit-unit.xml",
    "test:integration": "vitest run --project integration --reporter=default --reporter=junit --outputFile.junit=./tests/results/junit-integration.xml",
    "test:acceptance": "vitest run --project acceptance --reporter=default --reporter=junit --outputFile.junit=./tests/results/junit-acceptance.xml",
    "test:watch": "vitest",
    "test:coverage": "vitest run --project unit --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.70.0",
    "@anthropic-ai/sdk": "0.121.0",
    "@daytonaio/sdk": "npm:@daytona/sdk@^0.207.0",
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.10.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@opentelemetry/sdk-trace-node": "2.10.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "acp-http-client": "0.4.2",
    "pi-acp": "0.0.33",
    "sandbox-agent": "0.4.2",
    "undici": "8.10.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "0.28.1",
    "tsx": "4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@sandbox-agent/cli-linux-x64",
      "@sandbox-agent/cli-darwin-arm64",
      "@sandbox-agent/cli-darwin-x64",
      "@sandbox-agent/cli-linux-arm64",
      "esbuild"
    ],
    "patchedDependencies": {
      "acp-http-client@0.4.2": "patches/acp-http-client@0.4.2.patch",
      "sandbox-agent@0.4.2": "patches/sandbox-agent@0.4.2.patch",
      "pi-acp@0.0.33": "patches/pi-acp@0.0.33.patch"
    },
    "overrides": {
      "@hono/node-server": "1.19.15",
      "brace-expansion": "5.0.9",
      "fast-uri": "3.1.5",
      "hono": "4.12.34",
      "ip-address": "10.3.1",
      "postcss": "8.5.23",
      "protobufjs": "7.6.5",
      "shell-quote": "1.9.0",
      "tar": "7.5.21"
    }
  }
}
