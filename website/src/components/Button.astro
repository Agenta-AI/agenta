---
// The site's only button. Every visual rule lives in the .ag-btn classes in
// global.css, measured off the deployed Framer site: one size (36px tall,
// 0/12px padding, 8px radius, Inter 14/500 at 0.02em), a 1px border and an
// inset white highlight, with the fill and border colour set by the variant.
//
// React components cannot import this file, so they apply the same classes
// directly. Either way there is one definition. Never write a button's styles
// inline.
// Every other attribute (id, type, disabled, aria-*, data-*, download, …)
// passes straight through to the rendered element.
interface Props extends astroHTML.JSX.HTMLAttributes {
  variant?: "primary" | "outline" | "dark" | "ghost";
  href?: string;
  // Opens the link in a new tab (for destinations that leave the marketing
  // site, e.g. the docs). No effect when rendered as a <button> (no href).
  external?: boolean;
  // Stretches the button to its container's width (the mobile menu row).
  block?: boolean;
  class?: string;
}
const {
  variant = "primary",
  href,
  external = false,
  block = false,
  class: extraClass,
  ...rest
} = Astro.props;

const cls = ["ag-btn", `ag-btn--${variant}`, block && "ag-btn--block", extraClass]
  .filter(Boolean)
  .join(" ");

const Tag = href ? "a" : "button";
---

<Tag
  {...rest}
  class={cls}
  href={href}
  target={href && external ? "_blank" : undefined}
  rel={href && external ? "noopener" : undefined}><slot /></Tag
>
