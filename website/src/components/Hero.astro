---
import Badge from "./Badge.astro";
import Section from "./Section.astro";
// Hero — dark landing. Copy = the approved pivot rev-5 headline.
import HeroVideo from "./HeroVideo.astro";

const GET_STARTED = "https://cloud.agenta.ai/";
const READ_DOCS = "https://docs.agenta.ai/";

// heroPre + [chip] + heroPost form the headline. The chip is the single
// PP Mondwest highlighted word (yellow), per the type-role rules.
const heroPre = "The open-source workspace for your ";
const heroChip = "agents";
const heroPost = ".";
const heroSub =
  "Build agents through chat. Improve them with feedback. Share them with your whole team.";

// No hero video asset yet — the placeholder card stays gated off until one lands.
const SHOW_HERO_VIDEO = false;
---

<Section
  data-screen-label="Hero"
  class="ag-hero"
  style="background:var(--th-bg-1);padding:128px 0 136px;text-align:center;"
>
  <div style="display:flex;flex-direction:column;align-items:center;gap:32px;">
    <div style="display:flex;flex-direction:column;align-items:center;gap:28px;">
      <Badge href="/blog/introducing-agenta-2-0">Agenta 2.0 — read the announcement →</Badge>
      <h1
        class="ag-h1"
        style="margin:0;font:var(--text-display-xl);color:var(--th-text-hi);max-width:920px;text-wrap:pretty;"
      >
        {heroPre}<span
          class="ag-hero-chip"
          style="display:inline-block;padding:0.02em 0.1em 0.08em;border-radius:10px;background:var(--hchip-bg);box-shadow:var(--hchip-shadow);font-family:var(--font-bitmap,'PP Mondwest',monospace);font-weight:400;line-height:1.06;color:var(--hchip-text);vertical-align:baseline;"
          >{heroChip}</span
        ><span style="margin-left:-0.02em;">{heroPost}</span>
      </h1>
      <p
        style="margin:0;font:var(--text-body-md);color:var(--th-text-body);max-width:600px;text-wrap:pretty;"
      >
        {heroSub}
      </p>
    </div>

    <div style="display:flex;gap:12px;">
      <a
        class="ag-btn ag-btn--primary"
        href={GET_STARTED}
        target="_blank"
        rel="noopener"
        >Start building</a
      >
      <a
        class="ag-btn ag-btn--outline"
        href={READ_DOCS}
        target="_blank"
        rel="noopener"
        >Read the docs</a
      >
    </div>

    {SHOW_HERO_VIDEO && <HeroVideo />}
  </div>
</Section>

<style is:global>
  /* Highlighted-word chip: light = grey keycap chip with ink text (mockup);
     dark = the current translucent chip with the yellow bitmap word. */
  .ag-hero-chip {
    --hchip-bg: var(--grad-chip);
    --hchip-shadow: inset 0 2px 0.4px #ffffff;
    --hchip-text: var(--ink-900);
  }
  [data-theme="dark"] .ag-hero-chip {
    --hchip-bg: rgba(255, 255, 255, 0.07);
    --hchip-shadow:
      inset 0 1px 0.4px rgba(255, 255, 255, 0.25),
      0 0 0 1px rgba(255, 255, 255, 0.06);
    --hchip-text: var(--yellow-400);
  }
</style>
