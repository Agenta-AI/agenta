---
import Section from "./Section.astro";
// SiteFooter — dark footer. Content + links from the design's content/site.json
// (inlined to keep the website package self-contained). External links are real;
// internal routes point at their intended path (some 404 until those pages ship).
const blurb = "Fast-tracking LLM apps to production.";

// icon files: social-1 = X, social-2 = Slack, social-3 = GitHub,
// social-linkedin = LinkedIn. (social-4/social-5 are an OpenAI mark and a play
// glyph — not ours to show here, so they're left unreferenced.)
const socials = [
  { platform: "x", url: "https://x.com/agenta_ai", icon: "/icons/social-1.svg" },
  {
    platform: "linkedin",
    url: "https://www.linkedin.com/company/agenta-ai",
    icon: "/icons/social-linkedin.svg",
  },
  {
    platform: "github",
    url: "https://github.com/Agenta-AI/agenta",
    icon: "/icons/social-3.svg",
  },
  {
    platform: "slack",
    url: "https://join.slack.com/t/agenta-hq/shared_invite/zt-37pnbp5s6-mbBrPL863d_oLB61GSNFjw",
    icon: "/icons/social-2.svg",
  },
];

type Link = { label: string; href: string; external?: boolean };
// Product column removed — those product pages no longer exist. The remaining
// three columns hold Company / Resources / Legal.
const columns: { heading: string; links: Link[] }[] = [
  {
    heading: "Company",
    links: [
      { label: "Home", href: "/" },
      { label: "Pricing", href: "/pricing" },
      { label: "Contact", href: "/contact" },
    ],
  },
  {
    heading: "Resources",
    // Tutorial is hidden for now (Mahmoud). Docs/Changelog/Roadmap point at the
    // docs site, so they open in a new tab (external) like the live agenta.ai.
    links: [
      { label: "Docs", href: "https://docs.agenta.ai/", external: true },
      // Same-origin so the API surface is reachable (and discoverable) from
      // every page without leaving agenta.ai.
      { label: "API", href: "/api" },
      { label: "Changelog", href: "https://agenta.ai/docs/changelog/main", external: true },
      { label: "Roadmap", href: "https://agenta.ai/docs/roadmap", external: true },
      { label: "Blog", href: "/blog" },
      { label: "Status", href: "https://status.agenta.ai", external: true },
    ],
  },
  {
    heading: "Legal",
    links: [
      { label: "Imprint", href: "/imprint" },
      {
        label: "Terms of services",
        href: "https://agenta.ai/docs/administration/security/terms-of-service",
        external: true,
      },
      {
        label: "Privacy Policy",
        href: "https://agenta.ai/docs/administration/security/privacy-policy",
        external: true,
      },
      {
        label: "DPA",
        href: "https://agenta.ai/docs/administration/security/dpa",
        external: true,
      },
      { label: "Trust Center", href: "https://trustcenter.agenta.ai/", external: true },
    ],
  },
];

const copyright = `Copyright © 2020 – ${new Date().getFullYear()} Agentatech UG`;
---

<Section as="footer"
  class="ag-foot"
  style="background:var(--th-chrome);"
>
  <div
    class="ag-foot-top"
    style="display:flex;justify-content:space-between;gap:64px;padding:80px 172px 96px;flex-wrap:wrap;"
  >
    <div style="display:flex;flex-direction:column;align-items:flex-start;gap:18px;max-width:240px;">
      <img
        class="th-dark-only"
        src="/logos/Agenta-logo-full-dark.svg"
        alt="Agenta"
        style="height:23px;width:fit-content;display:block;"
      />
      <img
        class="th-light-only"
        src="/logos/Agenta-logo-full-light.svg"
        alt="Agenta"
        style="height:23px;width:fit-content;display:block;"
      />
      <span
        style="font:var(--text-body-sm);line-height:1.5;color:var(--ft-tagline);text-wrap:pretty;"
        >{blurb}</span
      >
      <div style="display:flex;gap:8px;margin-top:4px;">
        {
          socials.map((s) => (
            <a
              href={s.url}
              target="_blank"
              rel="noopener"
              aria-label={s.platform}
              class="ag-foot-social"
              style="width:34px;height:34px;border-radius:8px;background:var(--th-ctl-bg);box-shadow:inset 0 0 0 1px var(--ft-soc-ring);display:inline-flex;align-items:center;justify-content:center;"
            >
              <img
                src={s.icon}
                alt=""
                style="width:20px;height:20px;display:block;filter:var(--ft-soc-filter);"
              />
            </a>
          ))
        }
      </div>
    </div>
    <div
      class="ag-foot-cols"
      style="display:flex;gap:64px;flex-wrap:wrap;"
    >
      {
        columns.map((col) => (
          <div style="display:flex;flex-direction:column;gap:12px;min-width:120px;">
            <span style="font:var(--text-caption);letter-spacing:0.03em;color:var(--th-text-dim);">
              {col.heading}
            </span>
            {col.links.map((link) => (
              <a
                class="ag-foot-link"
                href={link.href}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noopener" : undefined}
                style="font:var(--text-label);color:var(--ft-link);cursor:pointer;text-decoration:none;"
              >
                {link.label}
              </a>
            ))}
          </div>
        ))
      }
    </div>
  </div>
  <div
    class="ag-foot-bottom"
    style="display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;padding:20px 172px;border-top:1px solid var(--th-border-subtle);"
  >
    <span style="font:var(--text-caption);color:var(--th-text-dim);"
      >{copyright}</span
    >
    <a
      class="ag-foot-link"
      href="https://agenta.ai/docs/administration/security/privacy-policy"
      target="_blank"
      rel="noopener"
      style="font:var(--text-caption);color:var(--th-text-dim);text-decoration:none;"
      >Privacy policy</a
    >
  </div>
</Section>

<style is:global>
  /* Footer text/tile values whose dark literals don't match any --th-* dark
     value exactly (tagline 0.55, links 0.62, tile ring 0.08). */
  .ag-foot {
    --ft-tagline: var(--ink-600);
    --ft-link: var(--ink-600);
    --ft-soc-ring: var(--paper-200);
    --ft-soc-filter: invert(0.35);
  }
  [data-theme="dark"] .ag-foot {
    --ft-tagline: rgba(255, 255, 255, 0.55);
    --ft-link: rgba(255, 255, 255, 0.62);
    --ft-soc-ring: rgba(255, 255, 255, 0.08);
    --ft-soc-filter: invert(1) brightness(0.8);
  }
</style>
