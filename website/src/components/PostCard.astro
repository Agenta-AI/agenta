---
// PostCard — the blog card, one component, four layouts (per COMPONENTS.md):
//   - featured:  index primary card (vertical, 300px hero, title + excerpt)
//   - secondary: index featured stack (horizontal, 116px thumb)
//   - grid:      index "All blogs" grid (vertical, 168px hero, excerpt)
//   - related:   post page "More from the blog" (vertical, 160px hero, no excerpt)
//
// Shows the hero image when present; otherwise a category-tinted gradient + a
// faded Agenta symbol (CONTENT_MODEL.md). Whole card links to /blog/<slug>.
// Theme-varying colors resolve through the --pc-* vars in the style block below
// (light per the light-theme spec; dark = the original hard-coded values). The
// category gradient is picked in CSS off [data-category] rather than in JS.
import type { Post } from "../lib/blog";
import { formatDate } from "../lib/blog";

interface Props {
  post: Post;
  variant?: "featured" | "secondary" | "grid" | "related";
}
const { post, variant = "grid" } = Astro.props;
const { title, description, category, date, heroImage } = post.data;
const href = `/blog/${post.id}`;
const dateLabel = formatDate(date);

// Vertical-card hero is a fixed 16:9 frame (matches agenta.ai/blog); the image
// fills it with object-fit:cover so no card size distorts the crop.

const darkPill =
  "position:relative;display:inline-flex;align-items:center;height:22px;padding:0 11px;border-radius:999px;background:var(--pc-pill-bg);box-shadow:var(--pc-pill-shadow);font:var(--text-caption);letter-spacing:0.04em;color:var(--pc-pill-text);";
const yellowPill =
  "position:relative;display:inline-flex;align-items:center;height:24px;padding:0 12px;border-radius:999px;background:var(--pc-ypill-bg);box-shadow:inset 0 0 0 1px rgba(242,242,92,0.3);font:var(--text-caption);letter-spacing:0.04em;color:var(--pc-ypill-text);";
---

{
  variant === "secondary" ? (
    <a
      href={href}
      data-category={category}
      class="ag-card"
      style="text-decoration:none;display:flex;flex:1;box-sizing:border-box;gap:16px;border-radius:12px;overflow:hidden;background:var(--pc-bg);box-shadow:var(--pc-ring);padding:14px;"
    >
      <div
        style="flex:0 0 40%;align-self:stretch;min-height:108px;border-radius:8px;background:var(--pc-thumb);box-shadow:var(--pc-thumb-ring);position:relative;overflow:hidden;"
      >
        {heroImage ? (
          <img
            src={heroImage}
            alt={title}
            loading="lazy"
            decoding="async"
            style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;"
          />
        ) : (
          <img
            src="/logos/Agenta-symbol-dark.svg"
            alt=""
            style="position:absolute;right:-12px;bottom:-16px;width:90px;opacity:0.08;"
          />
        )}
      </div>
      <div style="display:flex;flex-direction:column;gap:8px;min-width:0;padding:2px 0;">
        <span style="font:var(--text-caption);letter-spacing:0.04em;text-transform:uppercase;color:var(--pc-cat-sec);">
          {category}
        </span>
        <span style="font:300 18px/1.22 var(--font-display);color:var(--th-text-hi);text-wrap:pretty;">
          {title}
        </span>
        <span style="font:var(--text-caption);letter-spacing:0.03em;color:var(--pc-date-sec);margin-top:auto;">
          {dateLabel}
        </span>
      </div>
    </a>
  ) : (
    <a
      href={href}
      data-category={category}
      class="ag-card ag-vcard"
      style="text-decoration:none;border-radius:12px;overflow:hidden;background:var(--pc-bg);box-shadow:var(--pc-ring);"
    >
      <div
        style={`position:relative;aspect-ratio:16/9;background:${variant === "featured" ? "var(--pc-thumb-feat)" : "var(--pc-thumb)"};overflow:hidden;display:flex;align-items:flex-end;padding:16px;box-sizing:border-box;`}
      >
        {heroImage ? (
          <img
            src={heroImage}
            alt={title}
            loading="lazy"
            decoding="async"
            style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;"
          />
        ) : (
          <img
            src="/logos/Agenta-symbol-dark.svg"
            alt=""
            style="position:absolute;right:-18px;top:-22px;width:140px;opacity:0.06;"
          />
        )}
        <span style={variant === "featured" ? yellowPill : darkPill}>{category}</span>
      </div>
      <div style="padding:18px 18px 20px;display:flex;flex-direction:column;gap:10px;flex:1;">
        <h3
          style={`margin:0;font:300 ${variant === "featured" ? "32px/1.12" : variant === "related" ? "19px/1.25" : "20px/1.22"} var(--font-display);color:var(--th-text-hi);text-wrap:pretty;`}
        >
          {title}
        </h3>
        {variant !== "related" && (
          <p
            style={`margin:0;font:var(--text-body-sm);color:${variant === "featured" ? "var(--pc-desc-feat)" : "var(--pc-desc)"};text-wrap:pretty;`}
          >
            {description}
          </p>
        )}
        <span
          style={`font:var(--text-caption);letter-spacing:0.03em;color:${variant === "featured" ? "var(--pc-date-feat)" : "var(--pc-date)"};margin-top:auto;padding-top:8px;`}
        >
          {dateLabel}
        </span>
      </div>
    </a>
  )
}

<style is:global>
  /* PostCard theme vars. Defaults (:root scope via .ag-card) are the light
     values from the light-theme spec; [data-theme="dark"] restores the exact
     literals the card previously hard-coded, so dark stays pixel-identical.
     Thumb gradient is per-category off [data-category]; the non-Engineering
     default mirrors categoryGradient()'s Article fallback. */
  .ag-card {
    --pc-bg: var(--paper-50);
    --pc-ring: inset 0 0 0 1px var(--paper-150);
    --pc-thumb: linear-gradient(150deg, #b8e1ff, #a0d4fa);
    --pc-thumb-feat: linear-gradient(150deg, #f2f25c, #e9e93f);
    --pc-thumb-ring: inset 0 0 0 1px var(--paper-50);
    --pc-pill-bg: #ffffff;
    --pc-pill-shadow: 0 0 0 1px var(--paper-200);
    --pc-pill-text: var(--ink-600);
    --pc-ypill-bg: rgba(242, 242, 92, 0.45);
    --pc-ypill-text: var(--ink-900);
    --pc-cat-sec: var(--ink-900);
    --pc-desc: var(--ink-500);
    --pc-desc-feat: var(--ink-600);
    --pc-date: var(--ink-300);
    --pc-date-feat: var(--ink-500);
    --pc-date-sec: var(--ink-500);
  }
  .ag-card[data-category="Engineering"] {
    --pc-thumb: linear-gradient(150deg, #f5f55c, #ecec40);
  }
  /* Light-only hover: the card ring strengthens paper-150 → paper-200 (spec). */
  .ag-card:hover {
    --pc-ring: inset 0 0 0 1px var(--paper-200);
  }
  [data-theme="dark"] .ag-card {
    --pc-bg: rgba(255, 255, 255, 0.02);
    --pc-ring: inset 0 0 0 1px rgba(255, 255, 255, 0.07);
    --pc-thumb: linear-gradient(150deg, #211d1b, #131214);
    --pc-thumb-feat: var(--pc-thumb);
    --pc-thumb-ring: inset 0 0 0 1px rgba(255, 255, 255, 0.05);
    --pc-pill-bg: rgba(0, 0, 0, 0.35);
    --pc-pill-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.14);
    --pc-pill-text: rgba(255, 255, 255, 0.85);
    --pc-ypill-bg: rgba(242, 242, 92, 0.12);
    --pc-ypill-text: var(--yellow-400);
    --pc-cat-sec: var(--yellow-400);
    --pc-desc: rgba(255, 255, 255, 0.52);
    --pc-desc-feat: rgba(255, 255, 255, 0.52);
    --pc-date: rgba(255, 255, 255, 0.4);
    --pc-date-feat: rgba(255, 255, 255, 0.4);
    --pc-date-sec: rgba(255, 255, 255, 0.42);
  }
  [data-theme="dark"] .ag-card[data-category="Engineering"] {
    --pc-thumb: linear-gradient(150deg, #15181c, #101113);
  }
  /* Dark keeps its fixed ring on hover (no hover effect previously). */
  [data-theme="dark"] .ag-card:hover {
    --pc-ring: inset 0 0 0 1px rgba(255, 255, 255, 0.07);
  }
</style>
