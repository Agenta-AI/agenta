---
// Open standards — the marquee stack. Copy left, card right (.ag-interop grid,
// stacks to one column <=1100px via global.css). Each of the 5 rows is a label +
// an auto-scrolling chip strip whose direction alternates; hovering a row pauses
// its marquee and lets you scroll it horizontally (pure CSS, no island).
//
// Invariant: a marquee track is the chip strip DUPLICATED once and translated to
// -50% (keyframes ag-marquee / ag-marquee-rev in global.css), so it loops
// seamlessly. Never render a single (undoubled) strip on an animated track.

const local = (n: string) => `/logos/tools/${n}.svg`;

// Edge fade so chips dissolve into the card at both ends.
const MASK =
  "-webkit-mask-image:linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);mask-image:linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);";

type Chip = {
  name?: string;
  // Accessible name for icon-only chips (rendered as aria-label, never shown).
  label?: string;
  mono?: boolean;
  logo?: string;
  href?: string;
  soon?: boolean;
};

type Row = { label: string; speed: number; chips: Chip[] };

// [slug, href, accessible-name]. The MCPs row is logo-only (no visible text), so
// each link carries an aria-label for screen readers / keyboard users.
const mcp: Array<[string, string, string]> = [
  ["github", "https://github.com", "GitHub"],
  ["slack", "https://slack.com", "Slack"],
  ["linear", "https://linear.app", "Linear"],
  ["anthropic", "https://anthropic.com", "Anthropic"],
  ["notion", "https://notion.so", "Notion"],
  ["stripe", "https://stripe.com", "Stripe"],
  ["postgresql", "https://postgresql.org", "PostgreSQL"],
  ["hubspot", "https://hubspot.com", "HubSpot"],
  ["posthog", "https://posthog.com", "PostHog"],
  ["googledrive", "https://drive.google.com", "Google Drive"],
  ["zendesk", "https://zendesk.com", "Zendesk"],
  ["docker", "https://docker.com", "Docker"],
  ["figma", "https://figma.com", "Figma"],
  ["discord", "https://discord.com", "Discord"],
  ["asana", "https://asana.com", "Asana"],
  ["gitlab", "https://gitlab.com", "GitLab"],
  ["airtable", "https://airtable.com", "Airtable"],
  ["supabase", "https://supabase.com", "Supabase"],
  ["mongodb", "https://mongodb.com", "MongoDB"],
  ["cloudflare", "https://cloudflare.com", "Cloudflare"],
];

const rows: Row[] = [
  {
    label: "Skills",
    speed: 42,
    chips: [
      "review-diff",
      "classify",
      "research-company",
      "pull-metrics",
      "style-check",
      "answer-cited",
      "draft-outreach",
      "risk-scan",
      "build-dashboard",
    ].map((name) => ({ name, mono: true })),
  },
  {
    label: "MCPs & tools",
    speed: 30,
    chips: mcp.map(([slug, href, label]) => ({ logo: local(slug), href, label })),
  },
  {
    label: "Harness",
    speed: 55,
    chips: [
      { name: "Claude Code", logo: local("anthropic"), href: "https://claude.com/claude-code" },
      { name: "pi.dev", logo: local("pidev"), href: "https://pi.dev" },
      { name: "Codex", soon: true, logo: local("openai"), href: "https://openai.com/codex" },
      { name: "OpenCode", soon: true, logo: local("opencode"), href: "https://opencode.ai" },
      { name: "Hermes", soon: true, logo: local("hermes") },
    ],
  },
  {
    label: "Providers",
    speed: 50,
    chips: [
      { name: "Anthropic", logo: local("anthropic"), href: "https://anthropic.com" },
      { name: "OpenAI", logo: local("openai"), href: "https://openai.com" },
      { name: "Ollama", logo: local("ollama"), href: "https://ollama.com" },
      { name: "xAI", logo: local("xai"), href: "https://x.ai" },
      { name: "OpenRouter", logo: local("openrouter"), href: "https://openrouter.ai" },
      { name: "Your own gateway", logo: local("gateway") },
    ],
  },
  {
    label: "Runtime",
    speed: 48,
    chips: [
      { name: "Your local machine", logo: local("docker"), href: "https://docker.com" },
      { name: "Agenta Cloud", logo: "/logos/Agenta-symbol-dark.svg", href: "#" },
      { name: "Daytona", logo: local("daytona"), href: "https://daytona.io" },
      { name: "E2B", soon: true, logo: local("e2b"), href: "https://e2b.dev" },
      { name: "Vercel", soon: true, logo: local("vercel"), href: "https://vercel.com" },
    ],
  },
];

// Chip recipes are themed via the --ios-* vars below: light = the spec's white
// chip / terracotta skill chip / "Soon" pill; dark = the original literals.
const chipStyle = (c: Chip) => {
  const named = !!c.name;
  return (
    "flex:0 0 auto;display:inline-flex;align-items:center;gap:8px;" +
    `height:${named ? 36 : 44}px;padding:0 14px;border-radius:9px;white-space:nowrap;text-decoration:none;` +
    (c.href ? "cursor:pointer;" : "cursor:default;") +
    (c.mono ? "font:var(--app-text-mono);" : "font:var(--text-label);") +
    (c.soon
      ? "background:var(--ios-soon-bg);box-shadow:var(--ios-soon-shadow);color:var(--ios-soon-text);"
      : c.mono
        ? "background:var(--ios-skill-bg);box-shadow:var(--ios-skill-shadow);color:var(--ios-skill-text);"
        : "background:var(--ios-chip-bg);box-shadow:var(--ios-chip-shadow);color:var(--ios-chip-text);")
  );
};

// Marks tint grey #B9B8B6 by masking the (fill=currentColor) SVG, so any logo
// renders as a flat monochrome silhouette regardless of its source colors.
const logoStyle = (c: Chip) => {
  const s = c.name ? 15 : 20;
  return (
    `flex:0 0 auto;width:${s}px;height:${s}px;background-color:#B9B8B6;` +
    `-webkit-mask:url('${c.logo}') center/contain no-repeat;mask:url('${c.logo}') center/contain no-repeat;`
  );
};

const soonStyle =
  "font:500 10px/1 var(--font-sans);letter-spacing:0.05em;text-transform:uppercase;color:var(--ios-soontag-text);padding:3px 6px;border-radius:5px;background:var(--ios-soontag-bg);";

const labelStyle =
  "font:var(--text-caption);letter-spacing:0.06em;text-transform:uppercase;color:var(--ios-label);padding-left:28px;";

const isExternal = (href?: string) => !!href && href.startsWith("http");
---

<section
  data-screen-label="Open standards"
  class="ag-secpad ag-ios"
  style="background:var(--th-bg-1);border:1px solid var(--th-section-border);margin-top:-1px;padding:var(--section-pad-y) 0;display:flex;justify-content:center;"
>
  <div
    class="ag-interop"
    style="width:min(1120px,100%);display:grid;grid-template-columns:360px 1fr;gap:64px;padding:0 28px;box-sizing:border-box;text-align:left;align-items:center;"
  >
    <div style="display:flex;flex-direction:column;gap:20px;">
      <span
        style="align-self:flex-start;display:inline-flex;align-items:center;height:24px;padding:0 11px;border-radius:999px;background:var(--ios-pill-bg);box-shadow:var(--ios-pill-shadow);font:500 12px/1 var(--font-sans);letter-spacing:0.03em;color:var(--ios-pill-text);"
        >Open standards</span
      >
      <span
        class="ag-bighead"
        style="font:300 44px/1.1 var(--font-display,'GT Alpina',serif);color:var(--th-text-hi);"
        >One agent package, any stack</span
      >
      <span style="font:var(--text-body-md);color:var(--ios-body);"
        >Your agent is AGENTS.md, skills, and MCP tools. Swap the harness, model,
        or runtime without touching a line.</span
      >
      <span
        style="font:var(--text-body-sm);color:var(--th-text-mut);border-top:1px solid var(--ios-note-rule);padding-top:16px;"
        >When self-hosting locally, you can use your Claude or ChatGPT
        subscription.</span
      >
    </div>

    <div
      style="border-radius:12px;background:var(--ios-card-bg);box-shadow:var(--ios-card-shadow);padding:10px 0;display:flex;flex-direction:column;min-width:0;"
    >
      {
        rows.map((r, i) => (
          <div
            class="ag-io-row"
            style={
              "display:grid;grid-template-columns:130px 1fr;gap:16px;align-items:center;padding:17px 0;" +
              (i > 0 ? "border-top:1px solid var(--ios-row-rule);" : "")
            }
          >
            <span class="ag-io-label" style={labelStyle}>{r.label}</span>
            <div class="ag-io-view" style={"overflow:hidden;" + MASK}>
              <div
                class="ag-io-track"
                style={
                  "display:flex;gap:10px;width:max-content;padding:2px 0;animation:" +
                  (i % 2 ? "ag-marquee-rev" : "ag-marquee") +
                  " " +
                  r.speed +
                  "s linear infinite;"
                }
              >
                {r.chips.concat(r.chips).map((c, idx) => {
                  // The chip list is duplicated for the seamless scroll loop; the
                  // second copy is decorative, so hide it from AT and keyboard
                  // focus to avoid announcing/tabbing every link twice.
                  const dup = idx >= r.chips.length;
                  return c.href ? (
                    <a
                      href={c.href}
                      target={isExternal(c.href) ? "_blank" : undefined}
                      rel={isExternal(c.href) ? "noopener" : undefined}
                      style={chipStyle(c)}
                      aria-label={!c.name ? c.label : undefined}
                      aria-hidden={dup ? "true" : undefined}
                      tabindex={dup ? -1 : undefined}
                    >
                      {c.logo && <span style={logoStyle(c)} />}
                      {c.name && <span>{c.name}</span>}
                      {c.soon && <span style={soonStyle}>Soon</span>}
                    </a>
                  ) : (
                    <span style={chipStyle(c)} aria-hidden={dup ? "true" : undefined}>
                      {c.logo && <span style={logoStyle(c)} />}
                      {c.name && <span>{c.name}</span>}
                      {c.soon && <span style={soonStyle}>Soon</span>}
                    </span>
                  );
                })}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style is:global>
  /* Theme vars: light = the spec's Open-standards recipes (white section, white
     card, white/terracotta chips); dark = the original literals, verbatim. */
  .ag-ios {
    --ios-pill-bg: #ffffff;
    --ios-pill-shadow: 0 0 0 1px var(--paper-200);
    --ios-pill-text: var(--ink-600);
    --ios-body: var(--ink-600);
    --ios-note-rule: var(--paper-150);
    --ios-card-bg: var(--paper-0);
    --ios-card-shadow: 0 0 0 1px var(--th-border);
    --ios-row-rule: var(--paper-150);
    --ios-label: var(--ink-300);
    --ios-chip-bg: #ffffff;
    --ios-chip-shadow: var(--shadow-ring);
    --ios-chip-text: var(--ink-900);
    --ios-skill-bg: rgba(217, 119, 87, 0.12);
    --ios-skill-shadow: inset 0 0 0 1px rgba(217, 119, 87, 0.3);
    --ios-skill-text: var(--ink-900);
    --ios-soon-bg: var(--paper-150);
    --ios-soon-shadow: inset 0 0 0 1px var(--paper-150);
    --ios-soon-text: var(--ink-500);
    --ios-soontag-bg: rgba(36, 36, 36, 0.06);
    --ios-soontag-text: var(--ink-500);
  }
  [data-theme="dark"] .ag-ios {
    --ios-pill-bg: rgba(255, 255, 255, 0.06);
    --ios-pill-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
    --ios-pill-text: rgba(255, 255, 255, 0.7);
    --ios-body: rgba(255, 255, 255, 0.55);
    --ios-note-rule: rgba(255, 255, 255, 0.08);
    --ios-card-bg: var(--ag-d-bg-2);
    --ios-card-shadow:
      0 24px 70px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255, 255, 255, 0.07);
    --ios-row-rule: rgba(255, 255, 255, 0.06);
    --ios-label: rgba(255, 255, 255, 0.36);
    --ios-chip-bg: rgba(255, 255, 255, 0.06);
    --ios-chip-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.12);
    --ios-chip-text: rgba(255, 255, 255, 0.9);
    --ios-skill-bg: rgba(255, 255, 255, 0.06);
    --ios-skill-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.12);
    --ios-skill-text: rgba(255, 255, 255, 0.9);
    --ios-soon-bg: rgba(255, 255, 255, 0.02);
    --ios-soon-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.07);
    --ios-soon-text: rgba(255, 255, 255, 0.4);
    --ios-soontag-bg: rgba(255, 255, 255, 0.06);
    --ios-soontag-text: rgba(255, 255, 255, 0.35);
  }
</style>

<style>
  /* Hover a row: pause its marquee and let it scroll horizontally. The inline
     `animation` shorthand and `overflow:hidden` are inline styles, so these
     hover overrides need !important to win. */
  .ag-io-view::-webkit-scrollbar {
    display: none;
  }
  .ag-io-view:hover {
    overflow-x: auto !important;
    scrollbar-width: none;
  }
  .ag-io-view:hover .ag-io-track {
    animation-play-state: paused !important;
  }

  /* Phones: the 130px label column + 28px indent ate half the card, leaving the
     marquees barely visible. Narrow the labels, drop the indent, and tighten the
     row rhythm so the moving chip strips get much more width and the whole card
     reads more compact. */
  @media (max-width: 600px) {
    .ag-interop {
      padding-left: 16px !important;
      padding-right: 16px !important;
      gap: 40px !important;
    }
    .ag-io-row {
      grid-template-columns: 96px 1fr !important;
      gap: 12px !important;
      padding: 12px 0 !important;
    }
    .ag-io-label {
      padding-left: 12px !important;
      font-size: 11px !important;
      letter-spacing: 0.04em !important;
      white-space: nowrap;
    }
  }
</style>
