---
// Site — the shared page layout for the marketing site. Every page uses it,
// the landing included.
//
// Wraps Base (html/head: fonts, tokens, global CSS, meta/OG + a `head` slot) and
// renders the shared chrome around the page body: SiteNav, the page <slot/>, an
// optional yellow CTA band, and SiteFooter, all inside the 1440 column
// (`.ag-wrap` in global.css). Framer's column is flat: the page ground shows
// only outside it, on windows wider than 1440.
//
// `sticky` turns on the nav's scroll-pill behaviour. The landing passes it;
// inner pages get the identical bar as a static top bar.
import Base from "./Base.astro";
import SiteNav from "../components/SiteNav.astro";
import CtaBand from "../components/CtaBand.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface CtaProps {
  title?: string;
  body?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

interface Props {
  title?: string;
  description?: string;
  // og:type and og:image, passed straight through to Base for the head meta.
  // Blog posts set ogType="article" and an ogImage; everything else defaults.
  ogType?: "website" | "article";
  ogImage?: string;
  // Scroll-pill nav (landing only).
  sticky?: boolean;
  // Show the shared yellow CTA band before the footer (default: true).
  showCta?: boolean;
  // Optional copy/destinations for the CTA band; omitted keys fall back to the
  // landing defaults baked into CtaBand.astro.
  cta?: CtaProps;
}

const {
  title,
  description,
  ogType,
  ogImage,
  sticky = false,
  showCta = true,
  cta = {},
} = Astro.props;
---

<Base title={title} description={description} ogType={ogType} ogImage={ogImage}>
  <slot name="head" slot="head" />

  <div class="ag-wrap">
    <SiteNav sticky={sticky} />
    <main>
      <slot />
    </main>
    {showCta && <CtaBand {...cta} />}
    <SiteFooter />
  </div>
</Base>
