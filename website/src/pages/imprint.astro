---
import Badge from "../components/Badge.astro";
import Section from "../components/Section.astro";
import Site from "../layouts/Site.astro";

// Legal data confirmed by the founder on 2026-07-22 (register HRB 254081 B,
// VAT DE363150015, managing director). § 5 DDG replaced § 5 TMG in May 2024.
---

<Site
  title="Imprint — Agenta"
  description="Legal imprint for Agentatech UG (haftungsbeschränkt), Berlin. Required by § 5 DDG."
  showCta={false}
>
  <!-- ══ HERO ══════════════════════════════════════════════════════════ -->
  <Section tone="flat"
    style="background:var(--im-hero-bg);border-bottom:1px solid var(--th-section-border);"
  >
    <div
      style="max-width:860px;margin:0 auto;padding:96px 32px 80px;"
    >
      <Badge style="margin-bottom:24px;">Legal</Badge>
      <h1
        class="ag-h1"
        style="margin:0 0 16px;font:var(--text-display-lg);color:var(--th-text-hi);text-wrap:pretty;"
      >
        Imprint
      </h1>
      <p
        style="margin:0;font:var(--text-body-md);color:var(--th-text-body);max-width:540px;text-wrap:pretty;"
      >
        Information in accordance with § 5 DDG (Digitale-Dienste-Gesetz).
        This page also serves as the contact page for Agenta.
      </p>
    </div>
  </Section>

  <!-- ══ CONTENT ═══════════════════════════════════════════════════════ -->
  <Section tone="flat" style="background:var(--im-body-bg);padding:64px 32px 96px;">
    <div
      style="max-width:860px;margin:0 auto;display:flex;flex-direction:column;gap:32px;"
    >

      <!-- Legal notice panel -->
      <div
        class="ag-info-panel"
        style="border:1px solid var(--th-border-subtle);padding:40px 40px 36px;background:var(--im-panel-bg);"
      >
        <h2
          style="margin:0 0 24px;font:300 28px/1.15 var(--font-display,'GT Alpina',serif);color:var(--th-text-hi);"
        >
          Legal notice
        </h2>

        <dl
          class="ag-deflist"
          style="display:grid;grid-template-columns:160px 1fr;gap:12px 24px;font:var(--text-body-md);color:var(--th-text-body);margin:0;"
        >
          <dt style="color:var(--th-text-dim);font:var(--text-label);">Company</dt>
          <dd style="margin:0;overflow-wrap:anywhere;">Agentatech UG (haftungsbeschränkt)</dd>

          <dt style="color:var(--th-text-dim);font:var(--text-label);">Address</dt>
          <dd style="margin:0;overflow-wrap:anywhere;">
            c/o betahaus<br />
            Rudi-Dutschke-Straße 23<br />
            10969 Berlin<br />
            Germany
          </dd>

          <dt style="color:var(--th-text-dim);font:var(--text-label);">Represented by</dt>
          <dd style="margin:0;overflow-wrap:anywhere;">Managing director (Geschäftsführer): Mahmoud Mabrouk</dd>

          <dt style="color:var(--th-text-dim);font:var(--text-label);">Commercial register</dt>
          <dd style="margin:0;overflow-wrap:anywhere;">
            Amtsgericht Charlottenburg (Berlin)<br />
            HRB 254081 B
          </dd>

          <dt style="color:var(--th-text-dim);font:var(--text-label);">VAT ID</dt>
          <dd style="margin:0;overflow-wrap:anywhere;">
            USt-IdNr. in accordance with § 27a UStG: DE363150015
          </dd>

          <dt style="color:var(--th-text-dim);font:var(--text-label);">Responsible for content</dt>
          <dd style="margin:0;overflow-wrap:anywhere;">
            Mahmoud Mabrouk (address as above), § 18 Abs. 2 MStV
          </dd>
        </dl>
      </div>

      <!-- Contact panel -->
      <div
        class="ag-info-panel"
        style="border:1px solid var(--th-border-subtle);padding:40px 40px 36px;background:var(--im-panel-bg);"
      >
        <h2
          style="margin:0 0 24px;font:300 28px/1.15 var(--font-display,'GT Alpina',serif);color:var(--th-text-hi);"
        >
          Contact
        </h2>

        <dl
          class="ag-deflist"
          style="display:grid;grid-template-columns:160px 1fr;gap:12px 24px;font:var(--text-body-md);color:var(--th-text-body);margin:0;"
        >
          <dt style="color:var(--th-text-dim);font:var(--text-label);">Phone</dt>
          <dd style="margin:0;overflow-wrap:anywhere;">
            <a
              href="tel:+4915231036519"
              style="color:var(--th-text-body);text-decoration:none;"
            >
              +49-(0)-152-31036519
            </a>
          </dd>

          <dt style="color:var(--th-text-dim);font:var(--text-label);">Email</dt>
          <dd style="margin:0;overflow-wrap:anywhere;">
            <a
              href="mailto:team@agenta.ai"
              style="color:var(--th-text-body);text-decoration:none;"
            >
              team@agenta.ai
            </a>
          </dd>

          <dt style="color:var(--th-text-dim);font:var(--text-label);">Website</dt>
          <dd style="margin:0;overflow-wrap:anywhere;">
            <a
              href="https://agenta.ai"
              style="color:var(--th-text-body);text-decoration:none;"
            >
              agenta.ai
            </a>
          </dd>
        </dl>
      </div>

    </div>
  </Section>
</Site>

<style is:global>
  /* Theme-conditional values where the dark literal has no matching --th-*
     token. Light per the light-theme spec (white panels, paper-scale cards);
     dark = this page's previous literals, verbatim. */
  :root {
    --im-hero-bg: var(--th-bg-1);
    --im-body-bg: var(--th-bg-1);
    --im-panel-bg: var(--paper-50);
  }
  [data-theme="dark"] {
    --im-hero-bg: #0e0d0f;
    --im-body-bg: #0a0a0b;
    --im-panel-bg: #100f11;
  }
</style>
