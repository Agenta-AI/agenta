---
import Site from "../layouts/Site.astro";
import SectionTitle from "../components/SectionTitle.astro";
import HostingToggle from "../components/HostingToggle.tsx";
import PlanCard from "../components/PlanCard.astro";
import { linkify, type PricingLink } from "../lib/pricingLinks";

// Single source of truth for ALL pricing-page content. No content literals below.
import pricing from "../data/pricing.json";

const { hero, hostingToggle, plansByMode, comparisonByMode, faqs } = pricing;
const links = (pricing.links ?? []) as PricingLink[];
type Plan = (typeof plansByMode.cloud)[number];

// Hero / CTA-band destinations (not plan CTAs, which come from the data file).
const CLOUD = "https://cloud.agenta.ai/";
const DEMO = "https://cal.com/mahmoud-mabrouk-ogzgey/demo";

// Both comparison tables render server-side; the hosting toggle swaps them with the
// same data-hosting CSS mechanism as the plan grids (correct pre-hydration / no JS).
const comparisonModes = [
  { mode: "cloud" as const, cls: "mode-cloud", data: comparisonByMode.cloud },
  {
    mode: "selfHosted" as const,
    cls: "mode-selfhosted",
    data: comparisonByMode.selfHosted,
  },
];

const linkStyle =
  "color:var(--th-link);text-decoration:underline;text-underline-offset:2px;";
---

<Site
  title="Pricing — Agenta"
  description="Simple pricing that scales with your team. Self-host the open-source platform for free, or run on Agenta Cloud with prompt management, evaluation, and observability built in."
  cta={{
    title: "Start free, scale when you're ready",
    body: "Open-source and self-hostable forever. Sign up in seconds, no credit card required.",
    primaryLabel: "Get started",
    primaryHref: CLOUD,
    secondaryLabel: "Book a demo",
    secondaryHref: DEMO,
  }}
>
  <!-- #pricing-root carries data-hosting; the HostingToggle island flips it and
       the CSS below swaps the cloud / self-hosted plan sets. Default is cloud so
       the page is correct before hydration / without JS. -->
  <div id="pricing-root" data-hosting={hostingToggle.defaultMode === "selfHosted" ? "selfhosted" : "cloud"}>
    <!-- ============ HERO + HOSTING TOGGLE ============ -->
    <section class="pricing-hero" data-screen-label="Pricing hero">
      <div
        style="display:flex;flex-direction:column;align-items:center;gap:28px;"
      >
        <div
          style="display:flex;flex-direction:column;align-items:center;gap:22px;"
        >
          <span
            style="display:inline-flex;align-items:center;height:24px;padding:0 13px;border-radius:999px;background:var(--th-badge-bg);box-shadow:0 0 0 1px var(--th-badge-ring);font:var(--text-caption);letter-spacing:0.06em;text-transform:uppercase;color:var(--pp-eyebrow-text);"
            >{hero.eyebrow}</span
          >
          <h1
            class="ag-h1"
            style="margin:0;font:var(--text-display-lg);color:var(--th-text-hi);max-width:760px;text-wrap:pretty;"
          >
            {hero.headline}
          </h1>
          <p
            style="margin:0;font:var(--text-body-md);color:var(--th-text-body);max-width:560px;text-wrap:pretty;"
          >
            {hero.description}
          </p>
        </div>

        <HostingToggle
          client:visible
          targetId="pricing-root"
          defaultMode={hostingToggle.defaultMode as "cloud" | "selfHosted"}
          options={hostingToggle.options as { mode: "cloud" | "selfHosted"; label: string; sublabel?: string }[]}
        />
      </div>
    </section>

    <!-- ============ PLAN CARDS ============ -->
    <section class="cards-section" data-screen-label="Plan cards">
      <div class="plan-grid plan-grid-cloud mode-cloud">
        {plansByMode.cloud.map((plan: Plan) => <PlanCard plan={plan} links={links} />)}
      </div>
      <div class="plan-grid plan-grid-self mode-selfhosted">
        {plansByMode.selfHosted.map((plan: Plan) => <PlanCard plan={plan} links={links} />)}
      </div>
    </section>

    <!-- ============ COMPARISON TABLE ============ -->
    <!-- One comparison table per hosting mode, both server-rendered and swapped by the
         same data-hosting CSS as the plan grids. Cloud has 4 plan columns, self-hosted
         has 2 — each uses its own grid template so the 2-column table fills the width
         cleanly instead of leaving empty plan columns. -->
    <section class="cmp-section" data-screen-label="Comparison">
      {
        comparisonModes.map(({ cls, data }) => {
          const cols = data.columns.length;
          const COLS = `grid-template-columns:1.4fr repeat(${cols}, 1fr);`;
          // Phone column template + min-width (used via CSS vars in the <=760 media
          // query): a narrower sticky label track + fixed-width value columns so the
          // pinned Features column never overlaps the plan columns it scrolls past.
          const colsM = `128px repeat(${cols}, minmax(96px, 1fr))`;
          const minwM = 128 + cols * 96;
          // Wide (cloud/4-col) table keeps full-size columns and scrolls sideways on
          // narrow viewports; the 2-col table is capped narrower so it reads cleanly.
          const tableStyle =
            (cols >= 3
              ? "min-width:920px;max-width:1336px;margin:0 auto;"
              : "min-width:520px;max-width:900px;margin:0 auto;") +
            `--cmp-cols-m:${colsM};--cmp-minw-m:${minwM}px;`;
          return (
            <div class={`cmp-wrap ${cls}`}>
              <SectionTitle badge="Compare" title={data.title} />

              {/* Mobile-only affordance: the table scrolls sideways to reveal the
                  other plan columns, which isn't obvious on a phone. */}
              <span class="cmp-hint" aria-hidden="true">
                Scroll sideways to compare all plans →
              </span>

              <div class="cmp-scroll" data-scroll="dark">
                <div class="cmp-table" style={tableStyle}>
                  {/* header row */}
                  <div
                    class="cmp-row"
                    style={`display:grid;${COLS}align-items:end;padding:0 24px 18px;border-bottom:1px solid var(--pp-cmp-headrule);`}
                  >
                    <span class="cmp-c0" style="font:var(--text-label);color:var(--pp-cmp-mut);">
                      Features
                    </span>
                    {data.columns.map((c) => (
                      <div style="display:flex;flex-direction:column;gap:3px;">
                        <span style="font:300 19px/1.1 var(--font-display,'GT Alpina',serif);color:var(--th-text-hi);">
                          {c.name}
                        </span>
                        <span style="font:var(--text-caption);color:var(--pp-cmp-mut);">
                          {c.price}
                        </span>
                      </div>
                    ))}
                  </div>

                  {data.groups.map((g) => (
                    <Fragment>
                      <div style="padding:22px 24px 10px;">
                        <span style="font:var(--text-caption);letter-spacing:0.08em;text-transform:uppercase;color:var(--pp-cmp-group);">
                          {g.title}
                        </span>
                      </div>
                      {g.rows.map((r) => (
                        <div
                          class="cmp-row"
                          style={`display:grid;${COLS}align-items:center;padding:14px 24px;border-top:1px solid var(--th-border-subtle);`}
                        >
                          <span class="cmp-c0" style="font:var(--text-body-sm);color:var(--pp-cmp-cell);">
                            {linkify(r.label, links).map((part) => (part.href ? <a href={part.href} target={part.href.startsWith("mailto:") ? undefined : "_blank"} rel={part.href.startsWith("mailto:") ? undefined : "noopener"} style={linkStyle}>{part.text}</a> : <Fragment>{part.text}</Fragment>))}
                          </span>
                          {r.cells.map((cell) => (
                            <span style="display:flex;align-items:center;">
                              {cell === true ? (
                                <svg width="17" height="17" viewBox="0 0 18 18" fill="none">
                                  <circle cx="9" cy="9" r="9" fill="var(--pp-check-fill)" />
                                  <path
                                    d="M5 9.2 7.6 11.8 13 6.4"
                                    stroke="var(--pp-check-stroke)"
                                    stroke-width="1.7"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                  />
                                </svg>
                              ) : cell === false ? (
                                <span style="width:14px;height:1.5px;background:var(--pp-cmp-dash);border-radius:2px;" />
                              ) : (
                                <span style="font:var(--text-body-sm);color:var(--pp-cmp-cell);">
                                  {cell}
                                </span>
                              )}
                            </span>
                          ))}
                        </div>
                      ))}
                    </Fragment>
                  ))}
                </div>
              </div>
            </div>
          );
        })
      }
    </section>

    <!-- ============ FAQ ============ -->
    <section class="faq-section" data-screen-label="FAQ">
      <div class="faq-wrap">
        <SectionTitle
          badge="FAQ"
          title="Frequently asked questions"
          subtitle="Everything about plans, limits, and self-hosting. Still curious? Talk to the team."
        />
        <div class="faq-col">
          {
            faqs.map((f, i) => (
              <details class="faq-item" open={i === 0}>
                <summary>
                  <span class="faq-q">{f.question}</span>
                  <svg
                    class="faq-icon"
                    width="22"
                    height="22"
                    viewBox="0 0 24 24"
                    fill="none"
                  >
                    <path
                      d="M12 5v14M5 12h14"
                      stroke="var(--pp-faq-icon)"
                      stroke-width="1.5"
                      stroke-linecap="round"
                    />
                  </svg>
                </summary>
                <p class="faq-a">
                  {linkify(f.answer, links).map((part) => (part.href ? <a href={part.href} target={part.href.startsWith("mailto:") ? undefined : "_blank"} rel={part.href.startsWith("mailto:") ? undefined : "noopener"} style={linkStyle}>{part.text}</a> : <Fragment>{part.text}</Fragment>))}
                </p>
              </details>
            ))
          }
        </div>
      </div>
    </section>
  </div>
</Site>

<style>
  /* ── section shells (backgrounds + responsive padding) ── */
  .pricing-hero {
    background: var(--pp-sec-a);
    border: 1px solid var(--th-section-border);
    margin-top: -1px;
    text-align: center;
    padding: 80px 24px 56px;
  }
  .cards-section {
    background: var(--pp-sec-cards);
    border: 1px solid var(--th-section-border);
    margin-top: -1px;
    padding: 56px 0 96px;
  }
  .cmp-section {
    background: var(--pp-sec-a);
    border: 1px solid var(--th-section-border);
    margin-top: -1px;
    padding: 112px 0;
  }
  .faq-section {
    background: var(--pp-sec-faq);
    border: 1px solid var(--th-section-border);
    margin-top: -1px;
    padding: 112px 0;
  }

  /* ── plan cards grid ── */
  .plan-grid {
    display: grid;
    gap: 16px;
    margin: 0 auto;
    align-items: stretch;
    width: 100%;
    box-sizing: border-box;
    padding: 0 24px;
  }
  /* Cloud mode: four plans. Cards are subgrid children (PlanCard.astro); the grid
     defines no explicit rows, so the four row tracks are implicit and shared across a
     card row, which is what keeps every card's CTA divider on one line. */
  .plan-grid-cloud {
    grid-template-columns: repeat(4, 1fr);
    max-width: 1240px;
  }
  /* Self-hosted mode: two plans, centered (not stretched full width). */
  .plan-grid-self {
    grid-template-columns: repeat(2, 1fr);
    max-width: 720px;
  }

  /* ── hosting-mode swap (driven by #pricing-root[data-hosting]) ── */
  [data-hosting="cloud"] .mode-selfhosted {
    display: none;
  }
  [data-hosting="selfhosted"] .mode-cloud {
    display: none;
  }

  /* ── comparison table ── */
  .cmp-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 56px;
    width: 100%;
    box-sizing: border-box;
  }
  .cmp-scroll {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    padding: 0 24px;
    box-sizing: border-box;
    /* Horizontal scroll-shadow: an edge shadow signals the table scrolls to
       reveal the other plan columns, and fades out once scrolled to that end.
       Pure CSS via background-attachment (local covers vs scroll shadows). */
    background:
      linear-gradient(to right, var(--pp-cover) 42%, var(--pp-cover-t)) left
        center,
      linear-gradient(to left, var(--pp-cover) 42%, var(--pp-cover-t)) right
        center,
      radial-gradient(farthest-side at 0 50%, var(--pp-edge), var(--pp-edge-t))
        left center,
      radial-gradient(
          farthest-side at 100% 50%,
          var(--pp-edge),
          var(--pp-edge-t)
        )
        right center;
    background-repeat: no-repeat;
    background-size:
      34px 100%,
      34px 100%,
      16px 100%,
      16px 100%;
    background-attachment: local, local, scroll, scroll;
  }
  /* Scroll hint sits between the title and the table; phones only. */
  .cmp-hint {
    display: none;
    font: var(--text-caption);
    letter-spacing: 0.02em;
    color: var(--th-text-mut);
    text-align: center;
  }
  /* The table never collapses: it keeps full-size columns and scrolls sideways
     when the viewport is narrower than its min-width (see RESPONSIVE.md). */
  .cmp-table {
    min-width: 920px;
    max-width: 1336px;
    margin: 0 auto;
  }

  /* ── FAQ accordion (native <details>) ── */
  .faq-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 48px;
    width: 100%;
    box-sizing: border-box;
  }
  .faq-col {
    width: 100%;
    max-width: 768px;
    padding: 0 24px;
    box-sizing: border-box;
  }
  .faq-item {
    border-top: 1px solid var(--th-border);
    padding: 24px 0;
  }
  .faq-item summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-q {
    font: 300 20px/1.3 var(--font-display, "GT Alpina", serif);
    color: var(--th-text-hi);
  }
  .faq-icon {
    flex: 0 0 auto;
    margin-top: 2px;
    transition: transform 0.16s ease;
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
  }
  .faq-a {
    margin: 12px 0 0;
    max-width: 680px;
    font: var(--text-body-md);
    color: var(--th-text-body);
  }
  .faq-item[open] .faq-a {
    animation: accordion-in 0.2s ease both;
  }

  /* ── responsive: mirror agenta.ai/pricing — 4-across on desktop, halving to a
     two-up tablet grid, then a single column on phones (self-hosted keeps two). ── */
  @media (max-width: 900px) {
    .plan-grid-cloud {
      grid-template-columns: repeat(2, 1fr);
      max-width: 720px;
    }
  }
  @media (max-width: 760px) {
    .pricing-hero {
      padding: 52px 20px 40px;
    }
    .cards-section {
      padding: 40px 0 64px;
    }
    .cmp-section,
    .faq-section {
      padding: 72px 0;
    }
    .plan-grid,
    .faq-col {
      padding-left: 16px;
      padding-right: 16px;
    }
    /* The comparison table scrolls edge-to-edge on phones so the sticky label
       column can pin flush to the screen edge (no sliver of the scrolling plan
       columns peeking to its left). Row content keeps its own 24px gutter. */
    .cmp-scroll {
      padding-left: 0;
      padding-right: 0;
    }
    /* Tighten the comparison block and reveal the scroll hint on phones. */
    .cmp-wrap {
      gap: 24px;
    }
    .cmp-hint {
      display: block;
    }
    /* Narrower label track + fixed value columns on phones, so the sticky label
       column leaves room for the plan values instead of covering them. */
    .cmp-row {
      grid-template-columns: var(--cmp-cols-m) !important;
    }
    .cmp-table {
      min-width: var(--cmp-minw-m) !important;
    }
    /* Keep the feature-label column pinned while the plan columns scroll under
       it, so a scrolled row's values always have their label for context. */
    .cmp-c0 {
      position: sticky;
      left: 0;
      z-index: 2;
      /* Fill the full row height so the opaque background fully occludes the plan
         columns scrolling behind it (a text-height box would let them peek). */
      align-self: stretch;
      display: flex;
      align-items: center;
      background: var(--pp-sticky);
      box-shadow: var(--pp-sticky-shadow);
    }
  }
  @media (max-width: 680px) {
    .plan-grid-cloud,
    .plan-grid-self {
      grid-template-columns: 1fr;
      max-width: 420px;
    }
  }
</style>

<style is:global>
  /* Theme-conditional values for spots where the dark literal has no matching
     --th-* token. Light values per the light-theme spec; dark values are this
     page's previous hard-coded literals, verbatim. */
  #pricing-root {
    --pp-sec-a: var(--th-bg-1);
    --pp-sec-cards: var(--th-bg-1);
    --pp-sec-faq: var(--th-bg-1);
    --pp-eyebrow-text: var(--ink-600);
    --pp-cmp-headrule: var(--th-border);
    --pp-cmp-mut: var(--ink-500);
    --pp-cmp-group: var(--ink-900);
    --pp-cmp-cell: var(--ink-600);
    --pp-cmp-dash: rgba(36, 36, 36, 0.2);
    --pp-check-fill: var(--ink-900);
    --pp-check-stroke: #ffffff;
    --pp-faq-icon: #676770;
    --pp-cover: #ffffff;
    --pp-cover-t: rgba(255, 255, 255, 0);
    --pp-edge: rgba(36, 36, 36, 0.18);
    --pp-edge-t: rgba(36, 36, 36, 0);
    --pp-sticky: #ffffff;
    --pp-sticky-shadow: 10px 0 12px -8px rgba(36, 36, 36, 0.18);
  }
  [data-theme="dark"] #pricing-root {
    --pp-sec-a: #0e0d0f;
    --pp-sec-cards: #0a090a;
    --pp-sec-faq: #161518;
    --pp-eyebrow-text: rgba(255, 255, 255, 0.7);
    --pp-cmp-headrule: rgba(255, 255, 255, 0.12);
    --pp-cmp-mut: rgba(255, 255, 255, 0.5);
    --pp-cmp-group: var(--yellow-400);
    --pp-cmp-cell: rgba(255, 255, 255, 0.78);
    --pp-cmp-dash: rgba(255, 255, 255, 0.2);
    --pp-check-fill: var(--yellow-400);
    --pp-check-stroke: var(--ink-900);
    --pp-faq-icon: rgba(255, 255, 255, 0.55);
    --pp-cover: #0e0d0f;
    --pp-cover-t: rgba(14, 13, 15, 0);
    --pp-edge: rgba(0, 0, 0, 0.55);
    --pp-edge-t: rgba(0, 0, 0, 0);
    --pp-sticky: #0e0d0f;
    --pp-sticky-shadow: 10px 0 12px -8px rgba(0, 0, 0, 0.55);
  }

  /* Light-only zebra striping on comparison rows (spec: #fff / paper-50).
     The first .cmp-row is the header; dark keeps its unstriped rows. */
  :root:not([data-theme="dark"])
    #pricing-root
    .cmp-table
    > .cmp-row:nth-child(2n + 3 of .cmp-row) {
    background: var(--paper-50);
    --pp-sticky: var(--paper-50);
  }


  /* HostingToggle island — its inline React styles reference these vars.
     Light per spec; dark = the island's previous hard-coded literals. */
  .hosting-toggle {
    --ht-bg: var(--paper-50);
    --ht-ring: inset 0 0 0 1px var(--paper-150);
    --ht-on-bg: var(--paper-150);
    --ht-on-ring: inset 0 0 0 1px var(--paper-200);
    --ht-on-text: var(--ink-900);
    --ht-off-text: var(--ink-600);
    --ht-sub-text: var(--ink-500);
  }
  [data-theme="dark"] .hosting-toggle {
    --ht-bg: rgba(255, 255, 255, 0.04);
    --ht-ring: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
    --ht-on-bg: rgba(255, 255, 255, 0.08);
    --ht-on-ring: inset 0 0 0 1px rgba(255, 255, 255, 0.14);
    --ht-on-text: #f7f6f4;
    --ht-off-text: rgba(255, 255, 255, 0.55);
    --ht-sub-text: rgba(255, 255, 255, 0.5);
  }
</style>
