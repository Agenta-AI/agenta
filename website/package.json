{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agenta marketing website (agenta.ai) — Astro, static-first, deployed on Cloudflare Workers.",
  "packageManager": "pnpm@10.30.0",
  "scripts": {
    "fetch-fonts": "node scripts/fetch-fonts.mjs",
    "predev": "node scripts/fetch-fonts.mjs && node scripts/copy-openapi.mjs",
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "node scripts/fetch-fonts.mjs && node scripts/copy-openapi.mjs",
    "lint:ui": "node scripts/check-ui-primitives.mjs",
    "build": "node scripts/check-ui-primitives.mjs && astro build",
    "postbuild": "node scripts/verify-build.mjs",
    "preview": "astro preview",
    "deploy:preview": "PUBLIC_NOINDEX=true astro build && wrangler deploy",
    "astro": "astro",
    "check": "astro check",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.6",
    "@astrojs/react": "^6.0.5",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.2.8",
    "posthog-js": "^1.406.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "vitest": "^4.1.11",
    "wrangler": "4.131.1"
  }
}
